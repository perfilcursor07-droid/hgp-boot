<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Central de Chamados — Tempo Real</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg:          #070b11;
            --surface:     #0f1419;
            --surface2:    #151d26;
            --surface3:    #1b2633;
            --border:      #1e2d3d;
            --border2:     #2a3f52;
            --text:        #f1f5f9;
            --text2:       #cbd5e1;
            --muted:       #64748b;
            --green:       #22c55e;
            --green-bg:    rgba(34,197,94,0.1);
            --green-bdr:   rgba(34,197,94,0.4);
            --yellow:      #eab308;
            --yellow-bg:   rgba(234,179,8,0.1);
            --yellow-bdr:  rgba(234,179,8,0.4);
            --blue:        #3b82f6;
            --blue-bg:     rgba(59,130,246,0.1);
            --blue-bdr:    rgba(59,130,246,0.4);
            --red:         #ef4444;
            --red-bg:      rgba(239,68,68,0.1);
            --red-bdr:     rgba(239,68,68,0.4);
            --purple:      #a855f7;
            --purple-bg:   rgba(168,85,247,0.1);
            --purple-bdr:  rgba(168,85,247,0.4);
            --cyan:        #06b6d4;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100%;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
        }
        .tv-wrap { display: flex; flex-direction: column; height: 100vh; }

        /* ══ HEADER ══════════════════════════════════════════════════ */
        .tv-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 28px;
            background: linear-gradient(180deg, var(--surface) 0%, var(--surface2) 100%);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }
        .tv-header-left { display: flex; align-items: center; gap: 14px; }
        .tv-logo {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, #22c55e 0%, #06b6d4 100%);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
            box-shadow: 0 4px 16px rgba(34,197,94,0.3);
        }
        .tv-title { font-size: 20px; font-weight: 800; color: var(--text); letter-spacing: -0.5px; }
        .tv-live { display: flex; align-items: center; gap: 6px; margin-top: 2px; }
        .tv-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 8px var(--green);
            animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.8)} }
        .tv-live-text { font-size: 11px; color: var(--muted); font-weight: 500; }
        .tv-clock-block { text-align: right; }
        .tv-clock {
            font-size: 32px; font-weight: 900;
            font-variant-numeric: tabular-nums;
            background: linear-gradient(135deg, var(--blue), var(--cyan));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 1px; line-height: 1;
        }
        .tv-date { font-size: 11px; color: var(--muted); margin-top: 4px; font-weight: 500; }

        /* ══ STATS ═══════════════════════════════════════════════════ */
        .stats-bar {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            padding: 14px 28px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }
        .stat-card {
            border-radius: 14px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            border: 1px solid var(--border);
            background: var(--surface2);
            position: relative;
            overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            border-radius: 14px 14px 0 0;
        }
        .stat-card.red::before    { background: var(--red); }
        .stat-card.yellow::before { background: var(--yellow); }
        .stat-card.purple::before { background: var(--purple); }
        .stat-card.green::before  { background: var(--green); }
        .stat-card.blue::before   { background: var(--blue); }
        .stat-icon { font-size: 24px; flex-shrink: 0; line-height: 1; }
        .stat-info { min-width: 0; }
        .stat-value {
            font-size: 30px; font-weight: 900;
            font-variant-numeric: tabular-nums;
            line-height: 1;
        }
        .stat-label {
            font-size: 10px; color: var(--muted);
            text-transform: uppercase; letter-spacing: 0.6px;
            margin-top: 3px; font-weight: 600;
        }
        .stat-card.red    .stat-value { color: var(--red); }
        .stat-card.yellow .stat-value { color: var(--yellow); }
        .stat-card.purple .stat-value { color: var(--purple); }
        .stat-card.green  .stat-value { color: var(--green); }
        .stat-card.blue   .stat-value { color: var(--blue); }

        /* ══ BODY ════════════════════════════════════════════════════ */
        .tv-body {
            display: grid;
            grid-template-columns: 1fr 1fr;
            flex: 1;
            overflow: hidden;
            min-height: 0;
            gap: 1px;
            background: var(--border);
        }
        .tv-panel {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--bg);
        }
        .panel-header {
            padding: 12px 18px;
            background: var(--surface2);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }
        .panel-header-icon {
            width: 28px; height: 28px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px;
        }
        .panel-header-icon.open { background: var(--red-bg); border: 1px solid var(--red-bdr); }
        .panel-header-icon.done { background: var(--green-bg); border: 1px solid var(--green-bdr); }
        .panel-header h3 {
            font-size: 13px; font-weight: 700; flex: 1;
            color: var(--text2); letter-spacing: -0.2px;
        }
        .panel-badge {
            font-size: 11px; font-weight: 800;
            padding: 3px 10px; border-radius: 20px;
            min-width: 28px; text-align: center;
        }
        .badge-open   { background: var(--red-bg);   color: var(--red);   border: 1px solid var(--red-bdr); }
        .badge-closed { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-bdr); }
        .panel-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            scrollbar-width: thin;
            scrollbar-color: var(--border2) transparent;
        }
        .panel-list::-webkit-scrollbar { width: 4px; }
        .panel-list::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 4px; }

        /* ══ CARD ════════════════════════════════════════════════════ */
        .chamado-card {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px 14px;
            display: grid;
            grid-template-columns: 38px 1fr auto;
            gap: 12px;
            align-items: start;
            transition: border-color 0.3s, box-shadow 0.3s, transform 0.2s;
        }
        .chamado-card:hover {
            border-color: var(--border2);
            background: var(--surface3);
        }
        .chamado-card.new-item {
            animation: cardIn 0.5s cubic-bezier(0.16,1,0.3,1), glow 2.5s ease 0.5s;
        }
        @keyframes cardIn {
            from { opacity: 0; transform: translateY(-10px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes glow {
            0%   { border-color: var(--cyan); box-shadow: 0 0 20px rgba(6,182,212,0.4); }
            100% { border-color: var(--border); box-shadow: none; }
        }

        .card-icon {
            width: 38px; height: 38px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px; flex-shrink: 0;
        }
        .icon-pendente       { background: var(--yellow-bg); border: 1px solid var(--yellow-bdr); }
        .icon-aberto         { background: var(--blue-bg);   border: 1px solid var(--blue-bdr); }
        .icon-em_atendimento { background: var(--purple-bg); border: 1px solid var(--purple-bdr); }
        .icon-finalizado     { background: var(--green-bg);  border: 1px solid var(--green-bdr); }

        .card-body { min-width: 0; }
        .card-protocolo {
            font-size: 9px; color: var(--muted);
            font-family: 'Courier New', monospace;
            letter-spacing: 0.5px; margin-bottom: 2px;
            font-weight: 600;
        }
        .card-nome {
            font-size: 14px; font-weight: 700; color: var(--text);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .card-categoria {
            font-size: 11px; color: var(--text2);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            margin-top: 2px; font-weight: 500;
        }
        .card-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
        .card-tag {
            font-size: 10px; padding: 2px 8px;
            border-radius: 6px; white-space: nowrap; font-weight: 600;
        }
        .tag-setor     { background: var(--blue-bg);   color: var(--blue);   border: 1px solid var(--blue-bdr); }
        .tag-atendente { background: var(--purple-bg); color: var(--purple); border: 1px solid var(--purple-bdr); }

        .card-meta {
            display: flex; flex-direction: column;
            align-items: flex-end; gap: 6px;
            flex-shrink: 0; min-width: 120px;
        }
        .status-pill {
            font-size: 9px; font-weight: 800;
            padding: 3px 10px; border-radius: 20px;
            white-space: nowrap; text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .pill-pendente       { background: var(--yellow-bg); color: var(--yellow); border: 1px solid var(--yellow-bdr); }
        .pill-aberto         { background: var(--blue-bg);   color: var(--blue);   border: 1px solid var(--blue-bdr); }
        .pill-em_atendimento { background: var(--purple-bg); color: var(--purple); border: 1px solid var(--purple-bdr); }
        .pill-finalizado     { background: var(--green-bg);  color: var(--green);  border: 1px solid var(--green-bdr); }

        .card-tempo {
            font-size: 13px; font-weight: 800;
            font-variant-numeric: tabular-nums;
            text-align: right;
        }
        .card-tempo.ok      { color: var(--green); }
        .card-tempo.atencao { color: var(--yellow); }
        .card-tempo.urgente { color: var(--red); text-shadow: 0 0 8px rgba(239,68,68,0.4); }

        .card-datas { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
        .card-data-row {
            font-size: 10px; color: var(--muted);
            display: flex; align-items: center; gap: 4px; font-weight: 500;
        }
        .card-data-row .lbl {
            font-size: 8px; color: var(--border2);
            text-transform: uppercase; letter-spacing: 0.4px; font-weight: 700;
        }

        /* ══ EMPTY ═══════════════════════════════════════════════════ */
        .empty-state {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 12px; padding: 50px 20px;
            color: var(--muted); font-size: 13px; font-weight: 500;
        }
        .empty-state svg { opacity: 0.2; }

        /* ══ FOOTER ══════════════════════════════════════════════════ */
        .tv-footer {
            background: var(--surface);
            border-top: 1px solid var(--border);
            padding: 5px 28px;
            display: flex; align-items: center; justify-content: flex-end;
            flex-shrink: 0;
        }
        .tv-footer span { font-size: 10px; color: var(--muted); font-weight: 500; }
        .tv-footer .dev { color: var(--cyan); font-weight: 700; }

        /* ══ TICKER ══════════════════════════════════════════════════ */
        .tv-ticker {
            background: linear-gradient(90deg, var(--blue-bg), rgba(6,182,212,0.08));
            border-top: 1px solid var(--blue-bdr);
            padding: 6px 20px;
            font-size: 12px; color: var(--blue);
            display: flex; align-items: center; gap: 12px;
            overflow: hidden; flex-shrink: 0; font-weight: 600;
        }
        .ticker-label { font-weight: 800; white-space: nowrap; flex-shrink: 0; }
        .ticker-scroll { overflow: hidden; flex: 1; }
        .ticker-text {
            white-space: nowrap; display: inline-block;
            animation: ticker 25s linear infinite;
        }
        @keyframes ticker { from { transform: translateX(100%); } to { transform: translateX(-100%); } }

        /* ══ RESPONSIVO ══════════════════════════════════════════════ */
        @media (max-width: 768px) {
            html, body { overflow: auto; }
            .tv-wrap { height: auto; min-height: 100vh; }
            .tv-header { padding: 8px 14px; }
            .tv-logo { width: 32px; height: 32px; font-size: 16px; border-radius: 8px; }
            .tv-title { font-size: 15px; }
            .tv-clock { font-size: 20px; }
            .tv-date { font-size: 9px; }
            .stats-bar { grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 8px 12px; }
            .stat-card { padding: 8px 10px; gap: 8px; border-radius: 10px; }
            .stat-icon { font-size: 16px; }
            .stat-value { font-size: 22px; }
            .stat-label { font-size: 8px; }
            .tv-body { grid-template-columns: 1fr; overflow: visible; flex: none; background: var(--bg); gap: 0; }
            .tv-panel { border-bottom: 1px solid var(--border); max-height: none; overflow: visible; }
            .panel-list { overflow-y: visible; max-height: none; padding: 6px; gap: 5px; }
            .panel-header { padding: 8px 12px; }
            .chamado-card { grid-template-columns: 30px 1fr; gap: 8px; padding: 9px 10px; border-radius: 10px; }
            .card-icon { width: 30px; height: 30px; font-size: 13px; border-radius: 8px; }
            .card-meta {
                grid-column: 1 / -1; flex-direction: row;
                align-items: center; justify-content: space-between;
                min-width: 0; margin-top: 4px;
            }
            .card-tempo { font-size: 11px; }
            .card-datas { flex-direction: row; gap: 10px; }
            .card-nome { font-size: 12px; }
            .card-categoria { font-size: 10px; }
            .card-tag { font-size: 9px; padding: 1px 6px; }
            .status-pill { font-size: 8px; }
            .tv-footer { padding: 4px 14px; }
        }
        @media (max-width: 480px) {
            .stats-bar { grid-template-columns: repeat(2, 1fr); gap: 5px; padding: 6px 8px; }
            .stat-card:last-child { grid-column: 1 / -1; }
            .stat-value { font-size: 18px; }
            .tv-logo { width: 28px; height: 28px; font-size: 13px; }
            .tv-title { font-size: 13px; }
            .tv-clock { font-size: 18px; }
            .chamado-card { padding: 7px 8px; gap: 6px; }
            .card-nome { font-size: 11px; }
        }
    </style>
</head>
<body>
<div class="tv-wrap">

    <!-- Header -->
    <header class="tv-header">
        <div class="tv-header-left">
            <div class="tv-logo">📋</div>
            <div>
                <div class="tv-title">Central de Chamados</div>
                <div class="tv-live">
                    <span class="tv-dot"></span>
                    <span class="tv-live-text" id="statusLabel">Carregando...</span>
                </div>
            </div>
        </div>
        <div class="tv-clock-block">
            <div class="tv-clock" id="clock">--:--:--</div>
            <div class="tv-date" id="dateLabel"></div>
        </div>
    </header>

    <!-- Stats -->
    <div class="stats-bar">
        <div class="stat-card red">
            <div class="stat-icon">🔴</div>
            <div class="stat-info">
                <div class="stat-value" id="statAberto">—</div>
                <div class="stat-label">Em Aberto</div>
            </div>
        </div>
        <div class="stat-card yellow">
            <div class="stat-icon">⏳</div>
            <div class="stat-info">
                <div class="stat-value" id="statPendente">—</div>
                <div class="stat-label">Pendentes</div>
            </div>
        </div>
        <div class="stat-card purple">
            <div class="stat-icon">🔧</div>
            <div class="stat-info">
                <div class="stat-value" id="statAtendimento">—</div>
                <div class="stat-label">Em Atendimento</div>
            </div>
        </div>
        <div class="stat-card green">
            <div class="stat-icon">✅</div>
            <div class="stat-info">
                <div class="stat-value" id="statFinalizado">—</div>
                <div class="stat-label">Finalizados 24h</div>
            </div>
        </div>
        <div class="stat-card blue">
            <div class="stat-icon">⏱️</div>
            <div class="stat-info">
                <div class="stat-value" id="statMedia">—</div>
                <div class="stat-label">Tempo Médio</div>
            </div>
        </div>
    </div>

    <!-- Painéis -->
    <div class="tv-body">
        <div class="tv-panel">
            <div class="panel-header">
                <div class="panel-header-icon open">🔴</div>
                <h3>Chamados em Aberto</h3>
                <span class="panel-badge badge-open" id="badgeAbertos">0</span>
            </div>
            <div class="panel-list" id="listAbertos">
                <div class="empty-state">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    Carregando...
                </div>
            </div>
        </div>
        <div class="tv-panel">
            <div class="panel-header">
                <div class="panel-header-icon done">✅</div>
                <h3>Finalizados — Últimas 24h</h3>
                <span class="panel-badge badge-closed" id="badgeFinalizados">0</span>
            </div>
            <div class="panel-list" id="listFinalizados">
                <div class="empty-state">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    Carregando...
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="tv-footer">
        <span>Desenvolvido por <span class="dev">Erick Vinicius</span></span>
    </div>

    <!-- Ticker -->
    <div class="tv-ticker" id="ticker" style="display:none;">
        <span class="ticker-label">🔔 NOVO CHAMADO:</span>
        <div class="ticker-scroll">
            <span class="ticker-text" id="tickerText"></span>
        </div>
    </div>

</div>

<script>
    // ── Relógio
    function updateClock() {
        const now = new Date();
        document.getElementById('clock').textContent =
            now.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        document.getElementById('dateLabel').textContent =
            now.toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
    }
    updateClock();
    setInterval(updateClock, 1000);

    // ── Constantes
    const STATUS_ICON  = { pendente:'⏳', aberto:'📂', em_atendimento:'🔧', finalizado:'✅' };
    const STATUS_LABEL = { pendente:'Pendente', aberto:'Aberto', em_atendimento:'Em Atendimento', finalizado:'Finalizado' };

    // ── Helpers
    function fmtTempo(minutos) {
        if (minutos === null || minutos === undefined || isNaN(minutos)) return '—';
        minutos = Math.max(0, Math.round(Number(minutos)));
        if (minutos < 60) return minutos + 'min';
        const h = Math.floor(minutos / 60), m = minutos % 60;
        return m > 0 ? h + 'h ' + m + 'min' : h + 'h';
    }
    function tempoClass(min, status) {
        if (status === 'finalizado') return 'ok';
        const m = Number(min);
        if (m >= 120) return 'urgente';
        if (m >= 60) return 'atencao';
        return 'ok';
    }
    function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    // ── Render card
    function renderCard(c, isNew) {
        const status = c.status || 'pendente';
        const icon   = STATUS_ICON[status]  || '📋';
        const label  = STATUS_LABEL[status] || status;
        const mins   = c.minutos_total;
        const tc     = tempoClass(mins, status);
        const atendente = c.atendente_nome || c.tecnico_nome || '';
        const newCls = isNew ? 'new-item' : '';
        const tempoStr = status === 'finalizado'
            ? 'Resolvido em ' + fmtTempo(mins)
            : 'Aberto há ' + fmtTempo(mins);
        const criadoStr    = c.criado_fmt    || '—';
        const encerradoStr = c.encerrado_fmt || '—';
        const datasHtml = status === 'finalizado'
            ? '<div class="card-data-row"><span class="lbl">Aberto</span> ' + esc(criadoStr) + '</div>' +
              '<div class="card-data-row"><span class="lbl">Encerrado</span> ' + esc(encerradoStr) + '</div>'
            : '<div class="card-data-row"><span class="lbl">Aberto em</span> ' + esc(criadoStr) + '</div>';

        return '<div class="chamado-card ' + newCls + '" data-id="' + c.id + '">' +
            '<div class="card-icon icon-' + status + '">' + icon + '</div>' +
            '<div class="card-body">' +
                '<div class="card-protocolo">' + esc(c.protocolo || '#' + c.id) + '</div>' +
                '<div class="card-nome">' + esc(c.solicitante_nome || '—') + '</div>' +
                '<div class="card-categoria">' + esc(c.categoria || '—') + '</div>' +
                '<div class="card-tags">' +
                    (c.setor ? '<span class="card-tag tag-setor">📍 ' + esc(c.setor) + '</span>' : '') +
                    (atendente ? '<span class="card-tag tag-atendente">👤 ' + esc(atendente) + '</span>' : '') +
                '</div>' +
            '</div>' +
            '<div class="card-meta">' +
                '<span class="status-pill pill-' + status + '">' + label + '</span>' +
                '<span class="card-tempo ' + tc + '">' + tempoStr + '</span>' +
                '<div class="card-datas">' + datasHtml + '</div>' +
            '</div>' +
        '</div>';
    }

    // ── Estado
    let prevAbertosIds = new Set(), prevFinalizadosIds = new Set(), firstLoad = true;

    // ── Atualizar
    async function atualizar() {
        try {
            const r = await fetch('/api/tv/chamados');
            const d = await r.json();
            if (!d.success) return;

            const s = d.stats || {};
            document.getElementById('statAberto').textContent      = s.em_aberto      ?? '0';
            document.getElementById('statPendente').textContent    = s.pendentes       ?? '0';
            document.getElementById('statAtendimento').textContent = s.em_atendimento  ?? '0';
            document.getElementById('statFinalizado').textContent  = s.finalizados_24h ?? '0';
            const mediaMin = s.media_minutos_24h ?? s.media_minutos_geral ?? null;
            document.getElementById('statMedia').textContent = fmtTempo(mediaMin);

            // Detectar novos
            const novosAbertos = [], novosFinalizados = [];
            const abertosIds = new Set(d.abertos.map(c => c.id));
            const finalizadosIds = new Set(d.finalizados.map(c => c.id));
            if (!firstLoad) {
                d.abertos.forEach(c => { if (!prevAbertosIds.has(c.id)) novosAbertos.push(c); });
                d.finalizados.forEach(c => { if (!prevFinalizadosIds.has(c.id)) novosFinalizados.push(c); });
            }
            prevAbertosIds = abertosIds;
            prevFinalizadosIds = finalizadosIds;
            firstLoad = false;

            // Render abertos
            const listA = document.getElementById('listAbertos');
            document.getElementById('badgeAbertos').textContent = d.abertos.length;
            listA.innerHTML = d.abertos.length === 0
                ? '<div class="empty-state"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>Nenhum chamado em aberto</div>'
                : d.abertos.map(c => renderCard(c, novosAbertos.some(n => n.id === c.id))).join('');

            // Render finalizados
            const listF = document.getElementById('listFinalizados');
            document.getElementById('badgeFinalizados').textContent = d.finalizados.length;
            listF.innerHTML = d.finalizados.length === 0
                ? '<div class="empty-state"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>Nenhum finalizado nas últimas 24h</div>'
                : d.finalizados.map(c => renderCard(c, novosFinalizados.some(n => n.id === c.id))).join('');

            // Ticker
            if (novosAbertos.length > 0) {
                const txt = novosAbertos.map(c => c.protocolo + ' — ' + c.solicitante_nome + (c.setor ? ' · ' + c.setor : '')).join('   •   ');
                document.getElementById('tickerText').textContent = txt;
                document.getElementById('ticker').style.display = 'flex';
                setTimeout(function(){ document.getElementById('ticker').style.display = 'none'; }, 25000);
            }

            document.getElementById('statusLabel').textContent =
                'Atualizado às ' + new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        } catch (e) {
            document.getElementById('statusLabel').textContent = 'Erro ao atualizar...';
        }
    }

    // ── Auto-scroll
    function autoScroll(panelId) {
        const el = document.getElementById(panelId);
        if (!el) return;
        let dir = 1, pos = 0, paused = false;
        el.addEventListener('mouseenter', function(){ paused = true; });
        el.addEventListener('mouseleave', function(){ paused = false; });
        el.addEventListener('touchstart', function(){ paused = true; });
        el.addEventListener('touchend', function(){ setTimeout(function(){ paused = false; }, 3000); });
        setInterval(function() {
            if (paused) return;
            const max = el.scrollHeight - el.clientHeight;
            if (max <= 0) return;
            pos += dir * 0.7;
            if (pos >= max) dir = -1;
            if (pos <= 0) dir = 1;
            el.scrollTop = pos;
        }, 40);
    }

    // ── Init
    atualizar();
    setInterval(atualizar, 15000);
    setTimeout(function() {
        autoScroll('listAbertos');
        autoScroll('listFinalizados');
    }, 4000);
</script>
</body>
</html>
