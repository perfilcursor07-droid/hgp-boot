<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Central de Chamados — Tempo Real</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg:        #06090e;
            --surface:   #0c1118;
            --surface2:  #121922;
            --surface3:  #18212d;
            --border:    #1c2735;
            --border2:   #2a3a4d;
            --text:      #f1f5f9;
            --text2:     #cbd5e1;
            --muted:     #7b8ba1;
            --dim:       #4b5a6d;
            --green:  #22c55e; --green-bg:  rgba(34,197,94,.12);  --green-bdr:  rgba(34,197,94,.35);
            --yellow: #facc15; --yellow-bg: rgba(250,204,21,.12); --yellow-bdr: rgba(250,204,21,.35);
            --orange: #fb923c; --orange-bg: rgba(251,146,60,.12); --orange-bdr: rgba(251,146,60,.35);
            --red:    #f43f5e; --red-bg:    rgba(244,63,94,.12);  --red-bdr:    rgba(244,63,94,.4);
            --blue:   #3b82f6; --blue-bg:   rgba(59,130,246,.12); --blue-bdr:   rgba(59,130,246,.35);
            --purple: #a78bfa; --purple-bg: rgba(167,139,250,.12);--purple-bdr: rgba(167,139,250,.35);
            --cyan:   #22d3ee;
            --mono: 'JetBrains Mono', 'Courier New', monospace;
        }
        /* Escala tudo pela largura da tela: 1920px ≈ 15px */
        html { font-size: clamp(12px, 0.78vw, 24px); }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100%;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
        }
        svg { display: block; }
        .tv-wrap { display: flex; flex-direction: column; height: 100vh; }

        /* ══ HEADER ══════════════════════════════════════════════════ */
        .tv-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: .9rem 1.8rem;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }
        .tv-header-left { display: flex; align-items: center; gap: 1rem; }
        .tv-logo {
            width: 2.9rem; height: 2.9rem;
            background: linear-gradient(135deg, #22c55e 0%, #06b6d4 100%);
            border-radius: .8rem;
            display: flex; align-items: center; justify-content: center;
            color: #03130a;
        }
        .tv-logo svg { width: 1.5rem; height: 1.5rem; }
        .tv-title { font-size: 1.45rem; font-weight: 800; letter-spacing: -.02em; line-height: 1.1; }
        .tv-live { display: flex; align-items: center; gap: .45rem; margin-top: .25rem; }
        .tv-dot {
            width: .55rem; height: .55rem; border-radius: 50%;
            background: var(--green); box-shadow: 0 0 .5rem var(--green);
            animation: pulse 2s ease-in-out infinite;
        }
        .tv-dot.offline { background: var(--red); box-shadow: 0 0 .5rem var(--red); }
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.35} }
        .tv-live-text { font-size: .8rem; color: var(--muted); font-weight: 500; }
        .tv-live-text.offline { color: var(--red); font-weight: 700; }
        .tv-clock-block { text-align: right; }
        .tv-clock {
            font-family: var(--mono);
            font-size: 2.4rem; font-weight: 700;
            font-variant-numeric: tabular-nums;
            color: var(--text); line-height: 1; letter-spacing: .02em;
        }
        .tv-clock .sec { color: var(--muted); }
        .tv-date { font-size: .8rem; color: var(--muted); margin-top: .3rem; font-weight: 500; }

        /* ══ STATS ═══════════════════════════════════════════════════ */
        .stats-bar {
            display: grid; grid-template-columns: repeat(6, 1fr);
            gap: .8rem; padding: .9rem 1.8rem;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }
        .stat-card {
            border-radius: .9rem; padding: .85rem 1.1rem;
            border: 1px solid var(--border);
            background: var(--surface2);
            position: relative; overflow: hidden;
            display: flex; flex-direction: column; justify-content: center;
            transition: border-color .4s, background .4s;
        }
        .stat-card::before {
            content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: .25rem;
            background: var(--accent);
        }
        .stat-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
        .stat-label {
            font-size: .72rem; color: var(--muted);
            text-transform: uppercase; letter-spacing: .06em; font-weight: 700;
        }
        .stat-icon { color: var(--accent); opacity: .85; }
        .stat-icon svg { width: 1.2rem; height: 1.2rem; }
        .stat-value {
            font-size: 2.5rem; font-weight: 900; line-height: 1.05;
            font-variant-numeric: tabular-nums; color: var(--accent);
            margin-top: .2rem; letter-spacing: -.02em;
        }
        .stat-value.small { font-size: 2rem; }
        .stat-sub { font-size: .75rem; color: var(--muted); margin-top: .15rem; font-weight: 500; min-height: 1em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .stat-card.c-blue   { --accent: var(--blue); }
        .stat-card.c-yellow { --accent: var(--yellow); }
        .stat-card.c-purple { --accent: var(--purple); }
        .stat-card.c-red    { --accent: var(--red); }
        .stat-card.c-green  { --accent: var(--green); }
        .stat-card.c-cyan   { --accent: var(--cyan); }
        .stat-card.alarm { background: var(--red-bg); border-color: var(--red-bdr); animation: alarm 2.4s ease-in-out infinite; }
        .stat-card.alarm-y { background: var(--yellow-bg); border-color: var(--yellow-bdr); }
        @keyframes alarm { 0%,100%{box-shadow:none} 50%{box-shadow:0 0 1.4rem rgba(244,63,94,.35)} }
        .stat-card.muted .stat-value { color: var(--dim); }

        /* ══ BODY ════════════════════════════════════════════════════ */
        .tv-body {
            display: grid;
            grid-template-columns: 1.75fr 1fr;
            flex: 1; min-height: 0; overflow: hidden;
            gap: 1px; background: var(--border);
        }
        .tv-panel { display: flex; flex-direction: column; overflow: hidden; background: var(--bg); min-height: 0; }
        .side-col { display: grid; grid-template-rows: auto 1fr; gap: 1px; background: var(--border); min-height: 0; }

        .panel-header {
            padding: .75rem 1.2rem;
            background: var(--surface2);
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center; gap: .7rem;
            flex-shrink: 0;
        }
        .panel-header h3 { font-size: 1rem; font-weight: 800; flex: 1; color: var(--text); letter-spacing: -.01em; }
        .panel-header .hint { font-size: .75rem; color: var(--muted); font-weight: 500; }
        .panel-badge {
            font-size: .85rem; font-weight: 800;
            padding: .15rem .7rem; border-radius: 99px;
            min-width: 2.2rem; text-align: center; font-variant-numeric: tabular-nums;
        }
        .badge-open   { background: var(--blue-bg);  color: var(--blue);  border: 1px solid var(--blue-bdr); }
        .badge-closed { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-bdr); }
        .legend { display: flex; gap: .9rem; align-items: center; }
        .legend span { display: flex; align-items: center; gap: .35rem; font-size: .7rem; color: var(--muted); font-weight: 600; }
        .legend i { width: .6rem; height: .6rem; border-radius: 2px; display: inline-block; }

        .panel-list {
            flex: 1; overflow-y: auto; min-height: 0;
            padding: .8rem;
            scrollbar-width: none;
        }
        .panel-list::-webkit-scrollbar { display: none; }
        .grid-open {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(27rem, 1fr));
            gap: .6rem; align-content: start;
        }

        /* ══ CARD ABERTO ═════════════════════════════════════════════ */
        .ticket {
            --tier: var(--green); --tier-bg: var(--green-bg);
            background: var(--surface2);
            border: 1px solid var(--border);
            border-left: .35rem solid var(--tier);
            border-radius: .7rem;
            padding: .75rem .95rem .8rem;
            display: flex; flex-direction: column; gap: .3rem;
            min-width: 0;
        }
        .ticket.t-atencao { --tier: var(--yellow); --tier-bg: var(--yellow-bg); }
        .ticket.t-alerta  { --tier: var(--orange); --tier-bg: var(--orange-bg); }
        .ticket.t-critico { --tier: var(--red);    --tier-bg: var(--red-bg); background: linear-gradient(90deg, rgba(244,63,94,.07), var(--surface2) 55%); }
        .ticket.new-item { animation: cardIn .6s cubic-bezier(.16,1,.3,1), glow 3s ease .6s; }
        @keyframes cardIn { from { opacity: 0; transform: translateY(-.6rem) scale(.98); } to { opacity: 1; transform: none; } }
        @keyframes glow {
            0%   { box-shadow: 0 0 0 2px var(--cyan), 0 0 1.6rem rgba(34,211,238,.5); }
            100% { box-shadow: none; }
        }
        .t-row { display: flex; align-items: center; gap: .6rem; min-width: 0; }
        .t-row.space { justify-content: space-between; }
        .t-proto { font-family: var(--mono); font-size: .75rem; color: var(--muted); font-weight: 500; letter-spacing: .02em; }
        .t-cat {
            font-size: .7rem; font-weight: 700; color: var(--text2);
            background: var(--surface3); border: 1px solid var(--border2);
            padding: .05rem .5rem; border-radius: .35rem; white-space: nowrap;
        }
        .pill {
            font-size: .68rem; font-weight: 800;
            padding: .15rem .6rem; border-radius: 99px;
            white-space: nowrap; text-transform: uppercase; letter-spacing: .05em;
            margin-left: auto;
        }
        .pill-pendente       { background: var(--yellow-bg); color: var(--yellow); border: 1px solid var(--yellow-bdr); }
        .pill-aberto         { background: var(--blue-bg);   color: var(--blue);   border: 1px solid var(--blue-bdr); }
        .pill-em_atendimento { background: var(--purple-bg); color: var(--purple); border: 1px solid var(--purple-bdr); }
        .t-nome {
            font-size: 1.2rem; font-weight: 700; color: var(--text); letter-spacing: -.01em;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .t-setor { font-size: .85rem; color: var(--text2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500; }
        .t-setor .grp { color: var(--muted); font-weight: 700; font-size: .7rem; letter-spacing: .05em; margin-right: .35rem; }
        .t-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: .8rem; margin-top: .2rem; }
        .t-tec { font-size: .82rem; font-weight: 600; color: var(--purple); display: flex; align-items: center; gap: .35rem; min-width: 0; }
        .t-tec span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .t-tec svg { width: .9rem; height: .9rem; flex-shrink: 0; }
        .t-tec.none { color: var(--yellow); font-style: italic; }
        .t-time { text-align: right; flex-shrink: 0; }
        .t-elapsed {
            font-size: 1.35rem; font-weight: 900; color: var(--tier);
            font-variant-numeric: tabular-nums; line-height: 1; letter-spacing: -.01em;
        }
        .t-since { font-size: .68rem; color: var(--muted); margin-top: .2rem; font-weight: 500; }
        .ticket.t-critico .t-elapsed { text-shadow: 0 0 .8rem rgba(244,63,94,.45); }

        /* ══ RANKING TÉCNICOS ════════════════════════════════════════ */
        .rank-list { padding: .7rem 1rem .9rem; display: flex; flex-direction: column; gap: .55rem; background: var(--bg); }
        .rank-row { display: grid; grid-template-columns: 1.6rem 1fr auto; gap: .6rem; align-items: center; }
        .rank-pos {
            width: 1.6rem; height: 1.6rem; border-radius: .45rem;
            display: flex; align-items: center; justify-content: center;
            font-size: .78rem; font-weight: 800; background: var(--surface3); color: var(--muted);
        }
        .rank-row:nth-child(1) .rank-pos { background: rgba(250,204,21,.18); color: var(--yellow); }
        .rank-row:nth-child(2) .rank-pos { background: rgba(203,213,225,.14); color: var(--text2); }
        .rank-row:nth-child(3) .rank-pos { background: rgba(251,146,60,.16); color: var(--orange); }
        .rank-info { min-width: 0; }
        .rank-name { font-size: .88rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .rank-bar { height: .3rem; border-radius: 99px; background: var(--surface3); margin-top: .3rem; overflow: hidden; }
        .rank-bar i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--green), var(--cyan)); transition: width .8s ease; }
        .rank-val { text-align: right; }
        .rank-val b { font-size: 1.15rem; font-weight: 900; color: var(--green); font-variant-numeric: tabular-nums; }
        .rank-val small { display: block; font-size: .66rem; color: var(--muted); font-weight: 500; }

        /* ══ FINALIZADOS (linhas compactas) ══════════════════════════ */
        .done-list { display: flex; flex-direction: column; gap: .35rem; }
        .done-row {
            display: grid; grid-template-columns: 3.4rem 1fr auto; gap: .7rem; align-items: center;
            padding: .5rem .75rem; border-radius: .55rem;
            background: var(--surface2); border: 1px solid var(--border);
        }
        .done-row.new-item { animation: cardIn .6s cubic-bezier(.16,1,.3,1), glowG 3s ease .6s; }
        @keyframes glowG { 0% { box-shadow: 0 0 0 2px var(--green), 0 0 1.2rem rgba(34,197,94,.45); } 100% { box-shadow: none; } }
        .done-hora { font-family: var(--mono); font-size: .9rem; font-weight: 700; color: var(--green); }
        .done-main { min-width: 0; }
        .done-nome { font-size: .88rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .done-meta { font-size: .72rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: .1rem; }
        .done-meta .tec { color: var(--purple); font-weight: 600; }
        .done-dur { font-size: .8rem; font-weight: 800; color: var(--text2); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
        .done-dur.fast { color: var(--green); }
        .done-dur.slow { color: var(--orange); }

        /* ══ EMPTY ═══════════════════════════════════════════════════ */
        .empty-state {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            gap: .8rem; padding: 3rem 1rem; color: var(--muted); font-size: 1rem; font-weight: 600;
            grid-column: 1 / -1;
        }
        .empty-state svg { width: 3rem; height: 3rem; opacity: .35; }
        .empty-state.good { color: var(--green); }
        .empty-state.good svg { opacity: .7; }

        /* ══ FOOTER / TICKER ═════════════════════════════════════════ */
        .tv-footer {
            background: var(--surface); border-top: 1px solid var(--border);
            padding: .35rem 1.8rem; display: flex; align-items: center; justify-content: space-between;
            flex-shrink: 0; font-size: .7rem; color: var(--dim); font-weight: 500;
        }
        .tv-footer .dev { color: var(--cyan); font-weight: 700; }
        .tv-ticker {
            background: linear-gradient(90deg, rgba(34,211,238,.18), rgba(59,130,246,.1));
            border-top: 1px solid rgba(34,211,238,.45);
            padding: .55rem 1.4rem;
            font-size: 1rem; color: var(--cyan);
            display: none; align-items: center; gap: 1rem;
            overflow: hidden; flex-shrink: 0; font-weight: 700;
        }
        .tv-ticker.show { display: flex; }
        .ticker-label {
            font-weight: 900; white-space: nowrap; flex-shrink: 0;
            background: var(--cyan); color: #04212a; padding: .15rem .7rem; border-radius: .35rem;
            font-size: .8rem; letter-spacing: .06em;
        }
        .ticker-scroll { overflow: hidden; flex: 1; }
        .ticker-text { white-space: nowrap; display: inline-block; animation: ticker 22s linear infinite; }
        @keyframes ticker { from { transform: translateX(100vw); } to { transform: translateX(-100%); } }

        /* ══ RESPONSIVO ══════════════════════════════════════════════ */
        @media (max-width: 1100px) {
            html { font-size: 13px; }
            .stats-bar { grid-template-columns: repeat(3, 1fr); }
            .tv-body { grid-template-columns: 1fr 1fr; }
            .grid-open { grid-template-columns: 1fr; }
        }
        @media (max-width: 768px) {
            html, body { overflow: auto; }
            .tv-wrap { height: auto; min-height: 100vh; }
            .tv-header { padding: .7rem 1rem; }
            .tv-clock { font-size: 1.6rem; }
            .legend, .panel-header .hint { display: none; }
            .stats-bar { grid-template-columns: repeat(2, 1fr); gap: .5rem; padding: .7rem 1rem; }
            .stat-value { font-size: 1.9rem; }
            .stat-value.small { font-size: 1.5rem; }
            .tv-body { display: block; overflow: visible; background: var(--bg); }
            .side-col { display: block; }
            .tv-panel { overflow: visible; border-bottom: 1px solid var(--border); }
            .panel-list { overflow: visible; padding: .6rem 1rem; }
            .tv-footer { padding: .35rem 1rem; }
        }
    </style>
</head>
<body>
<div class="tv-wrap">

    <header class="tv-header">
        <div class="tv-header-left">
            <div class="tv-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="m9 14 2 2 4-4"/></svg>
            </div>
            <div>
                <div class="tv-title">Central de Chamados</div>
                <div class="tv-live">
                    <span class="tv-dot" id="liveDot"></span>
                    <span class="tv-live-text" id="statusLabel">Carregando...</span>
                </div>
            </div>
        </div>
        <div class="tv-clock-block">
            <div class="tv-clock" id="clock">--:--<span class="sec">:--</span></div>
            <div class="tv-date" id="dateLabel"></div>
        </div>
    </header>

    <div class="stats-bar">
        <div class="stat-card c-blue">
            <div class="stat-top"><span class="stat-label">Em aberto</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg></span></div>
            <div class="stat-value" id="statAberto">—</div>
            <div class="stat-sub">total na fila</div>
        </div>
        <div class="stat-card c-yellow" id="cardPendente">
            <div class="stat-top"><span class="stat-label">Sem técnico</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span></div>
            <div class="stat-value" id="statPendente">—</div>
            <div class="stat-sub" id="subPendente">aguardando atendimento</div>
        </div>
        <div class="stat-card c-purple">
            <div class="stat-top"><span class="stat-label">Em atendimento</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></span></div>
            <div class="stat-value" id="statAtendimento">—</div>
            <div class="stat-sub" id="subAtendimento">&nbsp;</div>
        </div>
        <div class="stat-card c-red" id="cardAtraso">
            <div class="stat-top"><span class="stat-label">Acima de 24h</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span></div>
            <div class="stat-value" id="statAtraso">—</div>
            <div class="stat-sub" id="subAtraso">&nbsp;</div>
        </div>
        <div class="stat-card c-green">
            <div class="stat-top"><span class="stat-label">Finalizados 24h</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg></span></div>
            <div class="stat-value" id="statFinalizado">—</div>
            <div class="stat-sub" id="subFinalizado">&nbsp;</div>
        </div>
        <div class="stat-card c-cyan">
            <div class="stat-top"><span class="stat-label" id="lblMedia">Tempo médio 24h</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2h4"/><path d="M12 14l3-3"/><circle cx="12" cy="14" r="8"/></svg></span></div>
            <div class="stat-value small" id="statMedia">—</div>
            <div class="stat-sub" id="subMedia">&nbsp;</div>
        </div>
    </div>

    <div class="tv-body">
        <section class="tv-panel">
            <div class="panel-header">
                <h3>Fila de chamados</h3>
                <div class="legend">
                    <span><i style="background:var(--green)"></i>&lt; 1h</span>
                    <span><i style="background:var(--yellow)"></i>1–4h</span>
                    <span><i style="background:var(--orange)"></i>4–24h</span>
                    <span><i style="background:var(--red)"></i>&gt; 24h</span>
                </div>
                <span class="panel-badge badge-open" id="badgeAbertos">0</span>
            </div>
            <div class="panel-list" id="listAbertos">
                <div class="grid-open" id="gridAbertos">
                    <div class="empty-state">Carregando...</div>
                </div>
            </div>
        </section>

        <div class="side-col">
            <section class="tv-panel">
                <div class="panel-header">
                    <h3>Técnicos — últimas 24h</h3>
                    <span class="hint">finalizados · tempo médio</span>
                </div>
                <div class="rank-list" id="rankList">
                    <div class="empty-state" style="padding:1.2rem">Carregando...</div>
                </div>
            </section>
            <section class="tv-panel">
                <div class="panel-header">
                    <h3>Finalizados recentemente</h3>
                    <span class="panel-badge badge-closed" id="badgeFinalizados">0</span>
                </div>
                <div class="panel-list" id="listFinalizados">
                    <div class="done-list" id="doneList">
                        <div class="empty-state">Carregando...</div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="tv-ticker" id="ticker">
        <span class="ticker-label">NOVO CHAMADO</span>
        <div class="ticker-scroll"><span class="ticker-text" id="tickerText"></span></div>
    </div>

    <div class="tv-footer">
        <span>Atualização automática a cada 15s</span>
        <span>Desenvolvido por <span class="dev">Erick Vinicius</span></span>
    </div>
</div>

<script>
    // ── Relógio
    function updateClock() {
        const now = new Date();
        const hm = now.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        const ss = String(now.getSeconds()).padStart(2, '0');
        document.getElementById('clock').innerHTML = hm + '<span class="sec">:' + ss + '</span>';
        const data = now.toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
        document.getElementById('dateLabel').textContent = data.charAt(0).toUpperCase() + data.slice(1);
    }
    updateClock();
    setInterval(updateClock, 1000);

    // ── Constantes
    const STATUS_LABEL = { pendente: 'Aguardando', aberto: 'Aberto', em_atendimento: 'Em atendimento' };
    const STATUS_ORDER = { pendente: 0, aberto: 1, em_atendimento: 2 };
    const PARTICULAS   = new Set(['da', 'de', 'do', 'das', 'dos', 'e', 'di', 'du']);
    const ICON_USER = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>';
    const ICON_WAIT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>';

    // ── Helpers
    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function fmtTempo(minutos) {
        if (minutos === null || minutos === undefined || isNaN(minutos)) return '—';
        minutos = Math.max(0, Math.round(Number(minutos)));
        if (minutos < 60) return minutos + 'min';
        if (minutos < 1440) {
            const h = Math.floor(minutos / 60), m = minutos % 60;
            return m > 0 ? h + 'h ' + m + 'min' : h + 'h';
        }
        const d = Math.floor(minutos / 1440), h = Math.floor((minutos % 1440) / 60);
        return h > 0 ? d + 'd ' + h + 'h' : d + 'd';
    }
    function tier(min) {
        if (min >= 1440) return 't-critico';
        if (min >= 240)  return 't-alerta';
        if (min >= 60)   return 't-atencao';
        return 't-ok';
    }
    // "LUCELIA DE SOUSA" / "lucelia de sousa" → "Lucelia de Sousa"
    function nomeProprio(s) {
        s = String(s || '').trim().replace(/\s+/g, ' ');
        if (!s) return '';
        return s.toLocaleLowerCase('pt-BR').split(' ').map(function (w, i) {
            if (i > 0 && PARTICULAS.has(w)) return w;
            return w.charAt(0).toLocaleUpperCase('pt-BR') + w.slice(1);
        }).join(' ');
    }
    // "HOSPITAIS - Hospital Geral de Palmas" → grupo + local
    function setorHtml(setor) {
        if (!setor) return '';
        const idx = setor.indexOf(' - ');
        if (idx > 0 && idx < 30) {
            return '<span class="grp">' + esc(setor.slice(0, idx).toUpperCase()) + '</span>' + esc(setor.slice(idx + 3));
        }
        return esc(setor);
    }
    // "23/09/2026 21:38" → "23/09 21:38" (ou só "21:38" se for hoje)
    function dataCurta(fmt) {
        if (!fmt) return '—';
        const m = /^(\d{2})\/(\d{2})\/\d{4} (\d{2}:\d{2})$/.exec(fmt);
        if (!m) return fmt;
        const hoje = new Date();
        const ehHoje = Number(m[1]) === hoje.getDate() && Number(m[2]) === hoje.getMonth() + 1;
        return ehHoje ? m[3] : m[1] + '/' + m[2] + ' ' + m[3];
    }
    function tecnico(c) { return nomeProprio(c.atendente_nome || c.tecnico_nome || ''); }
    function mediana(arr) {
        if (!arr.length) return null;
        const s = arr.slice().sort(function (a, b) { return a - b; });
        const mid = Math.floor(s.length / 2);
        return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
    }

    // ── Estado
    let dados = null, fetchedAt = 0, lastOkAt = 0;
    let prevAbertosIds = null, prevFinalizadosIds = null;
    let novosIds = new Set();
    let tickerTimer = null;

    // Minutos decorridos corrigidos pelo tempo desde a última busca (contagem ao vivo)
    function minutosVivos(c) {
        return Number(c.minutos_total || 0) + Math.floor((Date.now() - fetchedAt) / 60000);
    }

    // ── Renders
    function renderTicket(c) {
        const status = c.status || 'pendente';
        const min = minutosVivos(c);
        const tec = tecnico(c);
        const tecHtml = tec
            ? '<div class="t-tec">' + ICON_USER + '<span>' + esc(tec) + '</span></div>'
            : '<div class="t-tec none">' + ICON_WAIT + '<span>Aguardando técnico</span></div>';
        return '<article class="ticket ' + tier(min) + (novosIds.has('a' + c.id) ? ' new-item' : '') + '">' +
            '<div class="t-row">' +
                '<span class="t-proto">' + esc(c.protocolo || '#' + c.id) + '</span>' +
                (c.categoria ? '<span class="t-cat">' + esc(c.categoria) + '</span>' : '') +
                '<span class="pill pill-' + status + '">' + (STATUS_LABEL[status] || esc(status)) + '</span>' +
            '</div>' +
            '<div class="t-nome">' + esc(nomeProprio(c.solicitante_nome) || '—') + '</div>' +
            (c.setor ? '<div class="t-setor">' + setorHtml(c.setor) + '</div>' : '') +
            '<div class="t-foot">' + tecHtml +
                '<div class="t-time">' +
                    '<div class="t-elapsed">' + fmtTempo(min) + '</div>' +
                    '<div class="t-since">aberto ' + esc(dataCurta(c.criado_fmt)) + '</div>' +
                '</div>' +
            '</div>' +
        '</article>';
    }

    function renderDone(c) {
        const min = Number(c.minutos_total);
        const durCls = min <= 30 ? 'fast' : (min >= 240 ? 'slow' : '');
        const hora = c.encerrado_fmt ? c.encerrado_fmt.slice(-5) : '—';
        const tec = tecnico(c);
        const local = c.setor ? (c.setor.indexOf(' - ') > 0 ? c.setor.slice(c.setor.indexOf(' - ') + 3) : c.setor) : '';
        const meta = [
            tec ? '<span class="tec">' + esc(tec) + '</span>' : '',
            esc(c.categoria || ''),
            esc(local)
        ].filter(Boolean).join(' · ');
        return '<div class="done-row' + (novosIds.has('f' + c.id) ? ' new-item' : '') + '">' +
            '<div class="done-hora">' + esc(hora) + '</div>' +
            '<div class="done-main">' +
                '<div class="done-nome">' + esc(nomeProprio(c.solicitante_nome) || '—') + '</div>' +
                '<div class="done-meta">' + meta + '</div>' +
            '</div>' +
            '<div class="done-dur ' + durCls + '">' + fmtTempo(min) + '</div>' +
        '</div>';
    }

    function renderRanking(finalizados) {
        const map = {};
        finalizados.forEach(function (c) {
            const nome = tecnico(c);
            if (!nome) return;
            if (!map[nome]) map[nome] = { nome: nome, qtd: 0, mins: [] };
            map[nome].qtd++;
            if (c.minutos_total != null) map[nome].mins.push(Number(c.minutos_total));
        });
        const arr = Object.values(map).sort(function (a, b) { return b.qtd - a.qtd; }).slice(0, 6);
        if (!arr.length) return '<div class="empty-state" style="padding:1.2rem">Nenhum atendimento finalizado nas últimas 24h</div>';
        const max = arr[0].qtd;
        return arr.map(function (t, i) {
            const media = t.mins.length ? t.mins.reduce(function (a, b) { return a + b; }, 0) / t.mins.length : null;
            return '<div class="rank-row">' +
                '<div class="rank-pos">' + (i + 1) + '</div>' +
                '<div class="rank-info"><div class="rank-name">' + esc(t.nome) + '</div>' +
                    '<div class="rank-bar"><i style="width:' + Math.round(t.qtd / max * 100) + '%"></i></div></div>' +
                '<div class="rank-val"><b>' + t.qtd + '</b><small>' + fmtTempo(media) + '</small></div>' +
            '</div>';
        }).join('');
    }

    function setHtml(id, html) {
        const el = document.getElementById(id);
        if (el._last !== html) { el.innerHTML = html; el._last = html; }
    }
    function setText(id, txt) { document.getElementById(id).textContent = txt; }

    function render() {
        if (!dados) return;
        const s = dados.stats || {};
        const abertos = dados.abertos.slice();
        const finalizados = dados.finalizados;

        // Ordem da fila: sem técnico primeiro, depois os mais antigos
        abertos.sort(function (a, b) {
            const so = (STATUS_ORDER[a.status] ?? 9) - (STATUS_ORDER[b.status] ?? 9);
            return so !== 0 ? so : Number(b.minutos_total) - Number(a.minutos_total);
        });

        // Stats
        const pend = Number(s.pendentes || 0);
        const atend = Number(s.em_atendimento || 0);
        setText('statAberto', s.em_aberto ?? '0');
        setText('statPendente', pend);
        setText('statAtendimento', atend);
        setText('statFinalizado', s.finalizados_24h ?? '0');
        const tem24h = s.media_minutos_24h != null;
        setText('statMedia', fmtTempo(tem24h ? s.media_minutos_24h : s.media_minutos_geral));
        setText('lblMedia', tem24h ? 'Tempo médio 24h' : 'Tempo médio geral');

        const pendentes = abertos.filter(function (c) { return c.status === 'pendente'; });
        const maisAntigoPend = pendentes.reduce(function (m, c) { return Math.max(m, minutosVivos(c)); }, 0);
        setText('subPendente', pend ? 'espera máx. ' + fmtTempo(maisAntigoPend) : 'fila zerada');
        document.getElementById('cardPendente').classList.toggle('alarm-y', pend > 0);

        const tecnicosAtivos = new Set(abertos.filter(function (c) { return c.status === 'em_atendimento'; }).map(tecnico).filter(Boolean));
        setText('subAtendimento', tecnicosAtivos.size ? tecnicosAtivos.size + ' técnico' + (tecnicosAtivos.size > 1 ? 's' : '') + ' ativo' + (tecnicosAtivos.size > 1 ? 's' : '') : ' ');

        const atrasados = abertos.filter(function (c) { return minutosVivos(c) >= 1440; });
        const maisAntigo = abertos.reduce(function (m, c) { return Math.max(m, minutosVivos(c)); }, 0);
        setText('statAtraso', atrasados.length);
        setText('subAtraso', abertos.length ? 'mais antigo: ' + fmtTempo(maisAntigo) : ' ');
        document.getElementById('cardAtraso').classList.toggle('alarm', atrasados.length > 0);
        document.getElementById('cardAtraso').classList.toggle('muted', atrasados.length === 0);

        const rapidos = finalizados.filter(function (c) { return Number(c.minutos_total) <= 30; }).length;
        setText('subFinalizado', finalizados.length ? Math.round(rapidos / finalizados.length * 100) + '% em até 30min' : ' ');
        const med = mediana(finalizados.map(function (c) { return Number(c.minutos_total); }).filter(function (n) { return !isNaN(n); }));
        setText('subMedia', med != null ? 'mediana ' + fmtTempo(med) : ' ');

        // Fila
        setText('badgeAbertos', abertos.length);
        setHtml('gridAbertos', abertos.length === 0
            ? '<div class="empty-state good"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>Nenhum chamado em aberto</div>'
            : abertos.map(renderTicket).join(''));

        // Ranking + finalizados
        setHtml('rankList', renderRanking(finalizados));
        setText('badgeFinalizados', finalizados.length);
        setHtml('doneList', finalizados.length === 0
            ? '<div class="empty-state">Nenhum finalizado nas últimas 24h</div>'
            : finalizados.map(renderDone).join(''));
    }

    // ── Filtro de unidade
    const sessionUnidadeIds = <%- JSON.stringify(unidadeIds) %>;
    const sessionNivelAcesso = <%- JSON.stringify(nivelAcesso) %>;
    const tvParams = new URLSearchParams(window.location.search);
    const tvUnidadeId = tvParams.get('unidade_id') || '';
    const tvCodigo = tvParams.get('codigo') || '';

    function buildTvApiUrl() {
        const p = new URLSearchParams();
        // Prioridade: 1) parâmetro na URL, 2) unidades da sessão do usuário logado
        if (tvUnidadeId) {
            p.set('unidade_id', tvUnidadeId);
        } else if (tvCodigo) {
            p.set('codigo', tvCodigo);
        } else if (Array.isArray(sessionUnidadeIds) && sessionUnidadeIds.length > 0 && sessionNivelAcesso !== 'administrador') {
            p.set('unidade_id', sessionUnidadeIds[0]);
        }
        const qs = p.toString();
        return '/api/tv/chamados' + (qs ? '?' + qs : '');
    }

    function horaAgora() {
        return new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    function setOnline(ok) {
        document.getElementById('liveDot').classList.toggle('offline', !ok);
        const lbl = document.getElementById('statusLabel');
        lbl.classList.toggle('offline', !ok);
        if (ok) {
            lbl.textContent = 'Ao vivo · atualizado às ' + horaAgora();
        } else {
            const quando = lastOkAt ? new Date(lastOkAt).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : '—';
            lbl.textContent = 'Sem conexão · dados de ' + quando;
        }
    }

    function mostrarTicker(novos) {
        const txt = novos.map(function (c) {
            return (c.protocolo || '#' + c.id) + ' — ' + nomeProprio(c.solicitante_nome) + (c.setor ? ' · ' + c.setor : '');
        }).join('     •     ');
        document.getElementById('tickerText').textContent = txt;
        const t = document.getElementById('ticker');
        t.classList.add('show');
        clearTimeout(tickerTimer);
        tickerTimer = setTimeout(function () { t.classList.remove('show'); }, 30000);
    }

    // ── Atualizar
    async function atualizar() {
        try {
            const r = await fetch(buildTvApiUrl(), { cache: 'no-store' });
            const d = await r.json();
            if (!d.success) throw new Error('api');

            const abertosIds = new Set(d.abertos.map(function (c) { return c.id; }));
            const finalizadosIds = new Set(d.finalizados.map(function (c) { return c.id; }));
            novosIds = new Set();
            const novosAbertos = [];
            if (prevAbertosIds) {
                d.abertos.forEach(function (c) { if (!prevAbertosIds.has(c.id)) { novosIds.add('a' + c.id); novosAbertos.push(c); } });
                d.finalizados.forEach(function (c) { if (!prevFinalizadosIds.has(c.id)) novosIds.add('f' + c.id); });
            }
            prevAbertosIds = abertosIds;
            prevFinalizadosIds = finalizadosIds;

            dados = d;
            fetchedAt = lastOkAt = Date.now();
            render();
            // A animação de "novo" só deve rodar uma vez
            novosIds = new Set();

            if (novosAbertos.length) mostrarTicker(novosAbertos);
            setOnline(true);
        } catch (e) {
            setOnline(false);
        }
    }

    // ── Auto-scroll suave com pausa no topo e no fim
    function autoScroll(panelId) {
        const el = document.getElementById(panelId);
        if (!el) return;
        let dir = 1, pos = 0, hold = 0, paused = false;
        el.addEventListener('mouseenter', function () { paused = true; });
        el.addEventListener('mouseleave', function () { paused = false; pos = el.scrollTop; });
        el.addEventListener('touchstart', function () { paused = true; }, { passive: true });
        el.addEventListener('touchend', function () { setTimeout(function () { paused = false; pos = el.scrollTop; }, 4000); });
        setInterval(function () {
            if (paused) return;
            if (hold > 0) { hold--; return; }
            const max = el.scrollHeight - el.clientHeight;
            if (max <= 2) { pos = 0; el.scrollTop = 0; return; }
            pos = Math.min(max, Math.max(0, pos + dir * 0.8));
            el.scrollTop = pos;
            if (pos >= max && dir === 1)  { dir = -1; hold = 100; }   // ~4s parado no fim
            else if (pos <= 0 && dir === -1) { dir = 1; hold = 125; } // ~5s parado no topo
        }, 40);
    }

    // ── Init
    atualizar();
    setInterval(atualizar, 15000);
    setInterval(render, 30000); // mantém os tempos correndo entre as buscas
    setTimeout(function () {
        autoScroll('listAbertos');
        autoScroll('listFinalizados');
    }, 5000);
</script>
</body>
</html>
