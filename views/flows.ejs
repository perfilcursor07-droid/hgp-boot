<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Fluxos Bot V2 - HGP</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .fl-table { width: 100%; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; border-collapse: separate; border-spacing: 0; overflow: hidden; }
        .fl-table th { background: #f8fafc; color: #475569; font-size: 11px; text-transform: uppercase; padding: 12px 14px; text-align: left; border-bottom: 1px solid #e2e8f0; }
        .fl-table td { padding: 12px 14px; font-size: 13px; border-bottom: 1px solid #f1f5f9; }
        .fl-table tr:last-child td { border-bottom: none; }
        .fl-pill { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; }
        .fl-pill.ativo { background: #dcfce7; color: #16a34a; }
        .fl-pill.inativo { background: #fee2e2; color: #dc2626; }
        .fl-pill.padrao { background: #dbeafe; color: #2563eb; }
        .fl-actions { display: flex; gap: 6px; }
        .fl-btn { padding: 6px 12px; font-size: 11px; border-radius: 6px; border: 1px solid #e2e8f0; background: #f8fafc; cursor: pointer; font-weight: 600; }
        .fl-btn:hover { background: #e2e8f0; }
        .fl-btn.danger { color: #dc2626; }
        .fl-btn.primary { background: #25d366; color: #fff; border-color: #25d366; }

        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center; }
        .modal-overlay.open { display: flex; }
        .modal-box { background: #fff; border-radius: 12px; max-width: 900px; width: 95%; max-height: 95vh; overflow-y: auto; padding: 20px; }
        .modal-box h3 { margin-bottom: 14px; }
        .form-row { margin-bottom: 12px; }
        .form-row label { display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; }
        .form-row input, .form-row textarea { width: 100%; padding: 8px 10px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 13px; }
        .form-row textarea { resize: vertical; font-family: 'Courier New', monospace; font-size: 12px; }
        .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
        .btn-secondary { padding: 8px 14px; border: 1px solid #cbd5e1; background: #fff; color: #334155; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; }
        .btn-secondary:hover { background: #f1f5f9; }
        .btn-primary { padding: 8px 14px; border: none; background: #25d366; color: #fff; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; }
        .btn-primary:hover { background: #1ea855; }
        .info-box { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 10px 12px; font-size: 12px; color: #1e40af; margin-bottom: 14px; }
        .info-box code { background: #dbeafe; padding: 1px 5px; border-radius: 3px; font-family: monospace; }

        /* ── Simulador do Bot ── */
        .sim-modal { max-width: 480px; padding: 0; background: #efeae2; }
        .sim-header { background: #128C7E; color: #fff; padding: 12px 16px; display: flex; align-items: center; gap: 12px; }
        .sim-header .sim-avatar { width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 18px; }
        .sim-header h3 { font-size: 14px; margin: 0; font-weight: 600; }
        .sim-header small { font-size: 11px; opacity: 0.85; }
        .sim-header .sim-close { margin-left: auto; cursor: pointer; font-size: 22px; opacity: 0.8; }
        .sim-body {
            height: 460px;
            overflow-y: auto;
            padding: 14px;
            background-image: url("data:image/svg+xml,%3Csvg width='280' height='280' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3Cpattern id='p' width='20' height='20' patternUnits='userSpaceOnUse'%3E%3Ccircle cx='2' cy='2' r='0.5' fill='%23d4cfc4' opacity='0.4'/%3E%3C/pattern%3E%3C/defs%3E%3Crect width='280' height='280' fill='url(%23p)'/%3E%3C/svg%3E");
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .sim-msg {
            max-width: 80%;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 13px;
            line-height: 1.4;
            word-break: break-word;
            white-space: pre-wrap;
            box-shadow: 0 1px 0.5px rgba(0,0,0,0.06);
        }
        .sim-msg-bot { align-self: flex-start; background: #fff; border-top-left-radius: 0; }
        .sim-msg-user { align-self: flex-end; background: #d9fdd3; border-top-right-radius: 0; }
        .sim-input-bar {
            display: flex;
            gap: 8px;
            padding: 10px 12px;
            background: #f0f2f5;
            border-top: 1px solid #e2e8f0;
        }
        .sim-input-bar input {
            flex: 1;
            padding: 9px 14px;
            border: none;
            border-radius: 20px;
            background: #fff;
            font-size: 13px;
            outline: none;
        }
        .sim-input-bar button {
            width: 38px; height: 38px;
            border-radius: 50%;
            background: #25D366;
            color: #fff;
            border: none;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
        }
        .sim-foot {
            padding: 8px 12px;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11px;
            color: #64748b;
        }
        .sim-foot button {
            font-size: 11px; padding: 4px 10px;
            border-radius: 6px; border: 1px solid #e2e8f0;
            background: #fff; cursor: pointer;
        }
    </style>
</head>
<body>
    <% const isAdminUI = nivelAcesso === 'administrador'; %>
    <div class="dashboard">
        <%- include('partials/sidebar', { activePage: 'flows', username, role: 'Administrador', isAdmin: isAdminUI, nivelAcesso }) %>
        <main class="main-content">
            <div class="topbar">
                <div class="topbar-title-group">
                    <button class="menu-toggle" onclick="document.body.classList.toggle('sidebar-open')"><span></span><span></span><span></span></button>
                    <h2>Fluxos Bot V2</h2>
                </div>
                <div class="topbar-actions">
                    <button class="btn-primary" onclick="abrirNovo()">+ Novo Fluxo</button>
                </div>
            </div>
            <div class="content">
                <div class="info-box">
                    💡 Fluxos definem a sequência de menus, submenus e campos coletados pelo bot. Cada instância (não-legada) é vinculada a um fluxo.
                    A definição usa formato JSON com: <code>menuPrincipal</code>, <code>submenus</code>, <code>blocos</code>, <code>avaliacao</code>.
                </div>
                <table class="fl-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th>Status</th>
                            <th>Atualizado em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (flows.length === 0) { %>
                            <tr><td colspan="5" style="text-align:center;color:#64748b;padding:40px;">Nenhum fluxo cadastrado.</td></tr>
                        <% } else { flows.forEach(f => { %>
                            <tr>
                                <td><strong><%= f.nome %></strong> <% if (f.is_default) { %><span class="fl-pill padrao">padrão</span><% } %></td>
                                <td style="color:#64748b;font-size:12px;"><%= f.descricao || '—' %></td>
                                <td><span class="fl-pill <%= f.ativo ? 'ativo' : 'inativo' %>"><%= f.ativo ? 'Ativo' : 'Inativo' %></span></td>
                                <td style="color:#64748b;font-size:12px;"><%= new Date(f.atualizado_em).toLocaleString('pt-BR') %></td>
                                <td>
                                    <div class="fl-actions">
                                        <button class="fl-btn primary" onclick="simular(<%= f.id %>, '<%= f.nome.replace(/'/g, '\\\'') %>')" title="Simular bot">▶ Simular</button>
                                        <button class="fl-btn" onclick="editar(<%= f.id %>)">Editar</button>
                                        <button class="fl-btn danger" onclick="excluir(<%= f.id %>)">×</button>
                                    </div>
                                </td>
                            </tr>
                        <% }) } %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <div class="modal-overlay" id="modalFlow">
        <div class="modal-box">
            <h3 id="modalTitle">Novo Fluxo</h3>
            <form onsubmit="salvar(event)">
                <input type="hidden" id="flId">
                <div class="form-row">
                    <label>Nome *</label>
                    <input type="text" id="flNome" required>
                </div>
                <div class="form-row">
                    <label>Descrição</label>
                    <input type="text" id="flDescricao">
                </div>
                <div class="form-row">
                    <label>Definição (JSON) *</label>
                    <textarea id="flDef" rows="20" required></textarea>
                </div>
                <div class="form-row">
                    <label><input type="checkbox" id="flAtivo" checked style="width:auto"> Ativo</label>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary" onclick="fecharModal()">Cancelar</button>
                    <button type="button" class="btn-secondary" onclick="formatarJson()">Formatar JSON</button>
                    <button type="submit" class="btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Simulador do Bot -->
    <div class="modal-overlay" id="modalSim">
        <div class="modal-box sim-modal">
            <div class="sim-header">
                <div class="sim-avatar">🤖</div>
                <div>
                    <h3 id="simNome">Bot</h3>
                    <small>Simulação — não envia WhatsApp</small>
                </div>
                <span class="sim-close" onclick="fecharSim()">×</span>
            </div>
            <div class="sim-body" id="simBody"></div>
            <form class="sim-input-bar" onsubmit="simEnviar(event)">
                <input type="text" id="simInput" placeholder="Digite a resposta..." autocomplete="off">
                <button type="submit" title="Enviar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                </button>
            </form>
            <div class="sim-foot">
                <span id="simInfo">Aguardando início...</span>
                <button type="button" onclick="simReiniciar()">↺ Reiniciar</button>
            </div>
        </div>
    </div>

    <script>
        function abrirNovo() {
            document.getElementById('modalTitle').textContent = 'Novo Fluxo';
            document.getElementById('flId').value = '';
            document.getElementById('flNome').value = '';
            document.getElementById('flDescricao').value = '';
            document.getElementById('flDef').value = JSON.stringify({
                menuPrincipal: { titulo: '🤖 Menu', opcoes: [{id:'1', label:'Suporte', categoria:'Suporte', camposBloco:'padrao'}] },
                submenus: {},
                blocos: { padrao: { campos: [{key:'nome_completo', label:'NOME COMPLETO', obrigatorio:true, tipo:'texto'}, {key:'descricao', label:'DESCRIÇÃO', obrigatorio:true, tipo:'texto_longo'}] } },
                avaliacao: { habilitada: true, texto: 'Avalie de 1 a 5' },
                inatividadeMinutos: 10
            }, null, 2);
            document.getElementById('flAtivo').checked = true;
            document.getElementById('modalFlow').classList.add('open');
        }

        async function editar(id) {
            try {
                const r = await fetch('/api/flows/' + id);
                const d = await r.json();
                if (!d.success) { alert(d.message); return; }
                document.getElementById('modalTitle').textContent = 'Editar Fluxo';
                document.getElementById('flId').value = d.flow.id;
                document.getElementById('flNome').value = d.flow.nome;
                document.getElementById('flDescricao').value = d.flow.descricao || '';
                document.getElementById('flDef').value = JSON.stringify(d.flow.definicao, null, 2);
                document.getElementById('flAtivo').checked = !!d.flow.ativo;
                document.getElementById('modalFlow').classList.add('open');
            } catch (e) { alert(e.message); }
        }

        function fecharModal() {
            document.getElementById('modalFlow').classList.remove('open');
        }

        function formatarJson() {
            const ta = document.getElementById('flDef');
            try {
                const obj = JSON.parse(ta.value);
                ta.value = JSON.stringify(obj, null, 2);
            } catch (e) { alert('JSON inválido: ' + e.message); }
        }

        async function salvar(ev) {
            ev.preventDefault();
            const id = document.getElementById('flId').value;
            let definicao;
            try { definicao = JSON.parse(document.getElementById('flDef').value); }
            catch (e) { alert('JSON inválido: ' + e.message); return; }
            const body = {
                nome: document.getElementById('flNome').value.trim(),
                descricao: document.getElementById('flDescricao').value.trim(),
                definicao,
                ativo: document.getElementById('flAtivo').checked
            };
            try {
                const r = await fetch(id ? `/api/flows/${id}` : '/api/flows', {
                    method: id ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const d = await r.json();
                if (d.success) {
                    if (d.instanciasReiniciadas > 0) {
                        alert('✅ ' + d.message + '\n\nAs instâncias serão reconectadas em alguns segundos.');
                    }
                    location.reload();
                } else {
                    alert(d.message);
                }
            } catch (e) { alert(e.message); }
        }

        async function excluir(id) {
            if (!confirm('Excluir este fluxo?')) return;
            try {
                const r = await fetch('/api/flows/' + id, { method: 'DELETE' });
                const d = await r.json();
                if (d.success) location.reload();
                else alert(d.message);
            } catch (e) { alert(e.message); }
        }

        // ═══════════════════════════════════════════════════════════════
        // SIMULADOR DO BOT
        // ═══════════════════════════════════════════════════════════════
        let simFlow = null;
        let simEstado = null;

        async function simular(id, nome) {
            try {
                // Cache-busting: garantir que pega a versão mais recente do fluxo do banco
                const r = await fetch('/api/flows/' + id + '?t=' + Date.now(), { cache: 'no-store' });
                const d = await r.json();
                if (!d.success) { alert(d.message); return; }
                simFlow = d.flow.definicao;
                document.getElementById('simNome').textContent = nome;
                document.getElementById('modalSim').classList.add('open');
                simReiniciar();
            } catch (e) { alert(e.message); }
        }

        function fecharSim() {
            document.getElementById('modalSim').classList.remove('open');
            simFlow = null;
            simEstado = null;
        }

        function simReiniciar() {
            document.getElementById('simBody').innerHTML = '';
            document.getElementById('simInput').value = '';
            simEstado = { step: 'inicio' };
            document.getElementById('simInfo').textContent = 'Envie qualquer mensagem para começar...';
            simInputFocus();
        }

        function simInputFocus() {
            setTimeout(() => document.getElementById('simInput').focus(), 100);
        }

        function escMsg(s) {
            return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        function simBotMsg(texto) {
            const body = document.getElementById('simBody');
            const div = document.createElement('div');
            div.className = 'sim-msg sim-msg-bot';
            div.innerHTML = formatarMsg(texto);
            body.appendChild(div);
            body.scrollTop = body.scrollHeight;
        }

        function simUserMsg(texto) {
            const body = document.getElementById('simBody');
            const div = document.createElement('div');
            div.className = 'sim-msg sim-msg-user';
            div.textContent = texto;
            body.appendChild(div);
            body.scrollTop = body.scrollHeight;
        }

        function formatarMsg(t) {
            // *negrito* e _itálico_ estilo WhatsApp
            return escMsg(t)
                .replace(/\*([^\*]+)\*/g, '<strong>$1</strong>')
                .replace(/_([^_]+)_/g, '<em>$1</em>');
        }

        function montarMenuPrincipal() {
            const m = simFlow.menuPrincipal;
            const linhas = [m.titulo, ''];
            for (const o of m.opcoes) linhas.push(`*${o.id}* - ${o.label}`);
            linhas.push('', '_Digite o número da opção desejada ou CANCELAR para sair._');
            return linhas.join('\n');
        }

        function montarSubmenu(key) {
            const sm = simFlow.submenus?.[key];
            if (!sm) return null;
            const linhas = [sm.titulo, ''];
            for (const o of sm.opcoes) linhas.push(`*${o.id}* - ${o.label}`);
            linhas.push('', '_Digite o número da opção desejada._');
            return linhas.join('\n');
        }

        function obterBloco(key) {
            return simFlow.blocos?.[key] || simFlow.blocos?.padrao;
        }

        function simUnidadeSelecionadaEhHospital(dados = {}) {
            const unidade = simNormalizarTextoBusca(dados.unidade);
            return /\bhospitais?\b/.test(unidade);
        }

        function simLabelCampoParaEstado(c, estado) {
            if (c?.key === 'setor' && simUnidadeSelecionadaEhHospital(estado?.dados)) {
                return 'Nome do Hospital';
            }
            return c?.label || '';
        }

        function montarPromptCampo(c, estado = null) {
            const op = c.obrigatorio ? '' : ' _(opcional, envie - para pular)_';
            let prompt = `📝 *${simLabelCampoParaEstado(c, estado)}*${op}`;
            if (c.ajuda) {
                prompt += `\n\n_${c.ajuda}_`;
            }
            if (c.tipo === 'opcoes' && Array.isArray(c.opcoes)) {
                prompt += '\n';
                for (const opc of c.opcoes) {
                    prompt += `\n*${opc.id}* - ${opc.label}`;
                }
                prompt += '\n\n_Digite o número da opção._';
            }
            return prompt;
        }

        const SIM_CAMPOS_BLOQUEIO_HOSPITAL = ['unidade', 'setor'];
        const SIM_MENSAGEM_BLOQUEIO_HOSPITAL = '❌ Esta central não realiza abertura de chamados para hospitais. Procure o canal de atendimento interno da sua unidade hospitalar.';
        function simFluxoPermiteHospitais() {
            return simFlow?.permitirHospitais === true || simFlow?.aceitaHospitais === true;
        }
        const SIM_TERMOS_HGP_PERMITIDOS = [
