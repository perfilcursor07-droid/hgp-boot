            "fortaleza do tabocao"
        ];

        function simNormalizarTextoBusca(valor) {
            return String(valor || '')
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, ' ')
                .trim();
        }

        function simTermoNormalizadoPresente(texto, termo) {
            const escaped = termo.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return new RegExp('\\b' + escaped + '\\b').test(texto);
        }

        function simContemHospitalBloqueado(valor) {
            const texto = simNormalizarTextoBusca(valor);
            if (!texto) return false;

            const municipioBloqueado = SIM_MUNICIPIOS_TOCANTINS_BLOQUEADOS
                .find((municipio) => simTermoNormalizadoPresente(texto, municipio));
            const ehHgpPermitido = SIM_TERMOS_HGP_PERMITIDOS.some((termo) => termo.test(texto));

            if (ehHgpPermitido && (!municipioBloqueado || municipioBloqueado === 'palmas')) {
                return false;
            }

            if (SIM_TERMOS_HOSPITAL_BLOQUEADOS.some((termo) => termo.test(texto))) {
                return true;
            }

            if (municipioBloqueado) {
                return true;
            }

            return /\bhospital\b/.test(texto);
        }
        function validarCampo(v, tipo, opcoes) {
            v = String(v||'').trim();
            if (!v) return false;
            if (tipo === 'cpf') return v.replace(/\D/g,'').length === 11;
            if (tipo === 'email') return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
            if (tipo === 'telefone') { const d = v.replace(/\D/g,''); return d.length >= 10 && d.length <= 13; }
            if (tipo === 'opcoes') {
                if (!Array.isArray(opcoes)) return false;
                return opcoes.some(o => String(o.id) === v);
            }
            if (tipo === 'texto_longo') return v.length >= 5;
            return v.length >= 1;
        }

        async function simEnviar(ev) {
            ev.preventDefault();
            const inp = document.getElementById('simInput');
            const texto = inp.value.trim();
            if (!texto) return;
            inp.value = '';
            simUserMsg(texto);
            await new Promise(r => setTimeout(r, 250));
            await simProcessar(texto);
            simInputFocus();
        }

        async function simProcessar(texto) {
            if (!simFlow || !simEstado) return;
            if (texto.toUpperCase() === 'CANCELAR') {
                simBotMsg('✅ Atendimento cancelado. Envie qualquer mensagem para começar de novo.');
                simEstado = { step: 'inicio' };
                document.getElementById('simInfo').textContent = 'Cancelado.';
                return;
            }

            // Início → menu
            if (simEstado.step === 'inicio') {
                simEstado.step = 'menu';
                simBotMsg(montarMenuPrincipal());
                document.getElementById('simInfo').textContent = 'Aguardando opção do menu...';
                return;
            }

            // Menu principal
            if (simEstado.step === 'menu') {
                const opc = simFlow.menuPrincipal.opcoes.find(o => o.id === texto);
                if (!opc) {
                    simBotMsg('❌ Opção inválida.\n\n' + montarMenuPrincipal());
                    return;
                }
                simEstado.opcao = opc;
                simEstado.categoria = opc.categoria;

                if (opc.submenu) {
                    simEstado.step = 'submenu';
                    simEstado.submenuKey = opc.submenu;
                    simBotMsg(montarSubmenu(opc.submenu));
                    document.getElementById('simInfo').textContent = 'Aguardando opção do submenu...';
                } else {
                    simEstado.step = 'preenchimento';
                    simEstado.bloco = obterBloco(opc.camposBloco);
                    simEstado.campoIdx = 0;
                    simEstado.dados = {};
                    const campo = simEstado.bloco.campos[0];
                    simBotMsg(`📋 Categoria: *${opc.label}*\n\nVamos coletar seus dados.\n\n` + montarPromptCampo(campo, simEstado));
                    document.getElementById('simInfo').textContent = `Coletando ${simLabelCampoParaEstado(campo, simEstado)}...`;
                }
                return;
            }

            // Submenu
            if (simEstado.step === 'submenu') {
                const sm = simFlow.submenus[simEstado.submenuKey];
                const opc = sm.opcoes.find(o => o.id === texto);
                if (!opc) {
                    simBotMsg('❌ Opção inválida.\n\n' + montarSubmenu(simEstado.submenuKey));
                    return;
                }
                simEstado.subcategoria = opc.label;
                simEstado.step = 'preenchimento';
                simEstado.bloco = obterBloco(simEstado.opcao.camposBloco);
                simEstado.campoIdx = 0;
                simEstado.dados = {};
                const campo = simEstado.bloco.campos[0];
                simBotMsg(`📋 Sistema: *${opc.label}*\n\nVamos coletar seus dados.\n\n` + montarPromptCampo(campo, simEstado));
                document.getElementById('simInfo').textContent = `Coletando ${simLabelCampoParaEstado(campo, simEstado)}...`;
                return;
            }

            // Preenchimento
            if (simEstado.step === 'preenchimento') {
                const campo = simEstado.bloco.campos[simEstado.campoIdx];
                const pulou = texto === '-' && !campo.obrigatorio;
                if (!pulou) {
                    if (!validarCampo(texto, campo.tipo, campo.opcoes)) {
                        let dica = '';
                        if (campo.tipo === 'cpf') dica = '\n_O CPF deve ter 11 dígitos. Ex: 12345678901_';
                        else if (campo.tipo === 'email') dica = '\n_Informe um e-mail válido. Ex: nome@exemplo.com_';
                        else if (campo.tipo === 'telefone') dica = '\n_Informe o telefone com DDD. Ex: 6330274488 ou (63) 3027-4488 _';
                        else if (campo.tipo === 'opcoes') dica = '\n_Digite o número correspondente à opção desejada._';
                        else if (campo.tipo === 'texto_longo') dica = '\n_Por favor, descreva com mais detalhes (mínimo 5 caracteres)._';

                        simBotMsg(`❌ Valor inválido para *${simLabelCampoParaEstado(campo, simEstado)}*.${dica}\n\n` + montarPromptCampo(campo, simEstado));
                        return;
                    }
                    // Para opcoes, salvar o label da opção escolhida
                    if (!simFluxoPermiteHospitais() && SIM_CAMPOS_BLOQUEIO_HOSPITAL.includes(campo.key) && simContemHospitalBloqueado(texto)) {
                        simEstado = { step: 'menu' };
                        simBotMsg(SIM_MENSAGEM_BLOQUEIO_HOSPITAL + '\n\n' + montarMenuPrincipal());
                        document.getElementById('simInfo').textContent = 'Aguardando opção do menu...';
                        return;
                    }
                    if (campo.tipo === 'opcoes' && Array.isArray(campo.opcoes)) {
                        const escolhida = campo.opcoes.find(o => String(o.id) === texto);
                        simEstado.dados[campo.key] = escolhida ? escolhida.label : texto;
                    } else {
                        simEstado.dados[campo.key] = texto;
                    }
                } else {
                    simEstado.dados[campo.key] = null;
                }
                simEstado.campoIdx += 1;

                if (simEstado.campoIdx < simEstado.bloco.campos.length) {
                    const proximo = simEstado.bloco.campos[simEstado.campoIdx];
                    simBotMsg(montarPromptCampo(proximo, simEstado));
                    document.getElementById('simInfo').textContent = `Coletando ${simLabelCampoParaEstado(proximo, simEstado)}...`;
                    return;
                }

                // Final — simular criação
                const protocolo = 'SIM-' + Math.random().toString(36).substring(2,5).toUpperCase();
                simBotMsg(`✅ *Chamado simulado!*\n\n📌 Protocolo: *${protocolo}*\n📋 Categoria: ${simEstado.categoria}${simEstado.subcategoria ? '\n📂 Sistema: ' + simEstado.subcategoria : ''}\n\nDados coletados:\n${JSON.stringify(simEstado.dados, null, 2).replace(/[{}",]/g,'').replace(/\n\s*\n/g,'\n')}\n\n_Esta é apenas uma simulação. Nenhum chamado foi criado de verdade._`);
                document.getElementById('simInfo').textContent = '✓ Simulação concluída';
                simEstado = { step: 'fim' };
                return;
            }

            if (simEstado.step === 'fim') {
                simBotMsg('Simulação encerrada. Clique em Reiniciar para testar novamente.');
            }
        }
    </script>
</body>
</html>
