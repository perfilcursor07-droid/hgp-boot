    <script>
        let chatInterval = null;
        let chatIsFirstLoad = true;
        let chatMidiaArquivo = null;

        function autoResizeTextarea(el) {
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 120) + 'px';
        }

        function chatKeyDown(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                document.getElementById('formChat').requestSubmit();
            }
        }

        function selecionarMidia(input, tipo) {
            const file = input.files[0];
            if (!file) return;
            chatMidiaArquivo = file;

            const preview = document.getElementById('chatMediaPreview');
            const previewImg = document.getElementById('chatPreviewImg');
            const previewVideo = document.getElementById('chatPreviewVideo');
            const previewAudio = document.getElementById('chatPreviewAudio');
            const previewFilename = document.getElementById('chatPreviewFilename');

            previewImg.style.display = 'none';
            previewVideo.style.display = 'none';
            previewAudio.style.display = 'none';

            const url = URL.createObjectURL(file);
            if (file.type.startsWith('image/')) {
                previewImg.src = url;
                previewImg.style.display = 'block';
            } else if (file.type.startsWith('video/')) {
                previewVideo.src = url;
                previewVideo.style.display = 'block';
            } else {
                previewFilename.textContent = file.name;
                previewAudio.style.display = 'flex';
            }
            preview.style.display = 'block';
            input.value = '';
        }

        function removerMidiaPreview() {
            chatMidiaArquivo = null;
            document.getElementById('chatMediaPreview').style.display = 'none';
            document.getElementById('chatPreviewImg').src = '';
            document.getElementById('chatPreviewVideo').src = '';
        }

        async function abrirChat(chamadoId, protocolo) {
            // Limpar intervalo anterior para evitar carregar mensagens de outro chamado
            if (chatInterval) { clearInterval(chatInterval); chatInterval = null; }

            const chamadoAtual = chamadosState.find((item) => Number(item.id) === Number(chamadoId));
            const nome = chamadoAtual?.solicitante_nome || 'Solicitante';

            chamadoChatAbertoId = chamadoId;

            // Limpar mensagens anteriores imediatamente para não mostrar conversa de outro chamado
            document.getElementById('chatMessages').innerHTML = '<p class="chat-empty">Carregando mensagens...</p>';

            const placeholder = document.getElementById('chatPlaceholder');
            const painel = document.getElementById('modalChat');
            const workspace = document.getElementById('chamadosWorkspace');
            if (placeholder) placeholder.style.display = 'none';
            if (painel) painel.classList.add('is-open');
            if (workspace) workspace.classList.add('chat-open');

            document.querySelectorAll('.wa-conv.active').forEach((el) => el.classList.remove('active'));
            document.querySelector(`.wa-conv[data-id="${chamadoId}"]`)?.classList.add('active');

            document.getElementById('chatProtocolo').textContent = protocolo;
            document.getElementById('chatSolicitanteNome').textContent = nome;
            document.getElementById('chatSolicitanteTelefone').textContent = chamadoAtual?.telefone_contato || chamadoAtual?.telefone_whatsapp || 'Sem telefone';
            document.getElementById('chatAvatarInitial').textContent = nome.charAt(0).toUpperCase();
            document.getElementById('chatChamadoId').value = chamadoId;
            document.getElementById('chatMensagem').value = '';
            removerMidiaPreview();

            // Popular detalhes do chamado no card colapsável
            if (chamadoAtual) {
                document.getElementById('cdCategoria').textContent = chamadoAtual.categoria || '—';
                document.getElementById('cdSetor').textContent = chamadoAtual.setor || '—';
                document.getElementById('cdIP').textContent = chamadoAtual.ip_maquina || 'Não informado';

                // Código da impressora
                const codImp = chamadoAtual.cod_impressora || '';
                if (codImp) {
                    document.getElementById('cdImpressora').textContent = codImp;
                    document.getElementById('cdImpressoraRow').style.display = '';
                } else {
                    document.getElementById('cdImpressoraRow').style.display = 'none';
                }

                document.getElementById('cdTelefone').textContent = chamadoAtual.telefone_contato || chamadoAtual.telefone_whatsapp || 'Não informado';
                document.getElementById('cdDescricao').textContent = chamadoAtual.descricao || 'Sem descrição';

                // Email: usar coluna do banco; fallback para regex na descrição (compatibilidade)
                let email = chamadoAtual.email || '';
                if (!email) {
                    const m = String(chamadoAtual.descricao || '').match(/E-?MAIL:\s*([^\s\n]+@[^\s\n]+)/i);
                    if (m) email = m[1];
                }
                if (email) {
                    document.getElementById('cdEmail').textContent = email;
                    document.getElementById('cdEmailRow').style.display = '';
                } else {
                    document.getElementById('cdEmailRow').style.display = 'none';
                }

                // CPF: usar coluna do banco; fallback para regex na descrição
                let cpf = chamadoAtual.cpf_solicitante || '';
                if (!cpf) {
                    const m = String(chamadoAtual.descricao || '').match(/CPF:\s*([\d.\-]+)/i);
                    if (m) cpf = m[1];
                }
                if (cpf) {
                    document.getElementById('cdCpf').textContent = cpf;
                    document.getElementById('cdCpfRow').style.display = '';
                } else {
                    document.getElementById('cdCpfRow').style.display = 'none';
                }
            }

            // Se o chamado está finalizado: ocultar barra de composição (chat read-only)
            const formChat = document.getElementById('formChat');
            const btnEncerrarChat = document.getElementById('btnEncerrarNoChat');
            if (formChat) {
                if (chamadoAtual && chamadoAtual.status === 'finalizado') {
                    formChat.style.display = 'none';
                    if (btnEncerrarChat) btnEncerrarChat.style.display = 'none';
                    // Mostra aviso no lugar
                    let aviso = document.getElementById('chatFinalizadoAviso');
                    if (!aviso) {
                        aviso = document.createElement('div');
                        aviso.id = 'chatFinalizadoAviso';
                        aviso.style.cssText = 'background:#f1f5f9;border-top:1px solid #e2e8f0;padding:12px 16px;text-align:center;font-size:12px;color:#64748b;font-weight:500;';
                        aviso.innerHTML = '🔒 Chamado finalizado — somente leitura';
                        formChat.parentNode.insertBefore(aviso, formChat);
                    }
                    aviso.style.display = 'block';
                } else {
                    formChat.style.display = '';
                    if (btnEncerrarChat) btnEncerrarChat.style.display = 'flex';
                    const aviso = document.getElementById('chatFinalizadoAviso');
                    if (aviso) aviso.style.display = 'none';
                }
            }

            const badge = document.getElementById(`badge-${chamadoId}`);
            if (badge) badge.style.display = 'none';

            chatIsFirstLoad = true;
            await carregarMensagensChat(chamadoId);
            chatInterval = setInterval(() => carregarMensagensChat(chamadoId), 5000);
        }

        function toggleChatDetalhes() {
            const sidebar = document.querySelector('.chat-sidebar-info');
            if (sidebar) sidebar.classList.toggle('expanded');
        }

        function fecharChat() {
            const placeholder = document.getElementById('chatPlaceholder');
            const painel = document.getElementById('modalChat');
            const workspace = document.getElementById('chamadosWorkspace');
            if (painel) painel.classList.remove('is-open');
            if (placeholder) placeholder.style.display = 'flex';
            if (workspace) workspace.classList.remove('chat-open');
            document.querySelectorAll('.wa-conv.active').forEach((el) => el.classList.remove('active'));
            chamadoChatAbertoId = null;
            if (chatInterval) { clearInterval(chatInterval); chatInterval = null; }
        }

        function encerrarPeloChat() {
            const chamadoId = document.getElementById('chatChamadoId').value;
            const protocolo = document.getElementById('chatProtocolo').textContent;
            // Abre o modal de encerrar já com os dados preenchidos
            fecharChat();
            abrirModalEncerrar(chamadoId, protocolo);
        }

        function montarMidiaHtml(msg) {
            if (!msg.media_url) return '';
            // Mídia expirada (arquivo apagado por retenção)
            if (String(msg.media_url).startsWith('[expirado]')) {
                const tipo = msg.message_type || 'arquivo';
                const icone = tipo === 'image' ? '🖼️' : tipo === 'audio' ? '🎵' : tipo === 'video' ? '🎬' : '📎';
                return `<div class="chat-media chat-media-expirada">${icone} <em>Mídia expirada (chamado finalizado há mais de 7 dias)</em></div>`;
            }
            const isImagem = msg.message_type === 'image';
            const isAudio  = msg.message_type === 'audio' || msg.message_type === 'ptt';
            const isVideo  = msg.message_type === 'video';
            const isArquivo = msg.media_url && !isImagem && !isAudio && !isVideo;
            if (isImagem)  return `<div class="chat-media"><a href="${msg.media_url}" target="_blank" rel="noopener noreferrer"><img src="${msg.media_url}" alt="Imagem"></a></div>`;
            if (isAudio)   return `<div class="chat-media"><audio controls><source src="${msg.media_url}" type="${msg.media_mime_type || 'audio/ogg'}"></audio></div>`;
            if (isVideo)   return `<div class="chat-media"><video controls><source src="${msg.media_url}" type="${msg.media_mime_type || 'video/mp4'}"></video></div>`;
            if (isArquivo) return `<div class="chat-media"><a href="${msg.media_url}" target="_blank" rel="noopener noreferrer">📎 ${escapeHtml(msg.media_filename || 'Abrir arquivo')}</a></div>`;
            return '';
        }

        async function carregarMensagensChat(chamadoId) {
            try {
                // Verificar se o chat aberto ainda é o mesmo chamado (evita race condition)
                const chamadoAberto = document.getElementById('chatChamadoId').value;
                if (String(chamadoAberto) !== String(chamadoId)) return;

                const response = await fetch(`/api/chamados/${chamadoId}/chat`);
                const result = await response.json();
                if (!result.success) return;

                // Verificar novamente após o fetch (pode ter mudado durante a requisição)
                const chamadoAbertoAgora = document.getElementById('chatChamadoId').value;
                if (String(chamadoAbertoAgora) !== String(chamadoId)) return;

                const chatMessages = document.getElementById('chatMessages');
                const threshold = 80;
                const wasAtBottom = chatMessages.scrollHeight - chatMessages.scrollTop - chatMessages.clientHeight < threshold;

                if (result.mensagens.length === 0) {
                    chatMessages.innerHTML = '<p class="chat-empty">Nenhuma mensagem ainda.</p>';
                } else {
                    let html = '';
                    let lastDate = '';
                    let prevTipo = '';
                    let prevNome = '';
                    result.mensagens.forEach(msg => {
                        const dt = new Date(msg.enviada_em);
                        const dateKey = dt.toLocaleDateString('pt-BR');
                        if (dateKey !== lastDate) {
                            html += `<div class="chat-date-separator"><span>${dateKey}</span></div>`;
                            lastDate = dateKey;
                            prevTipo = '';
                            prevNome = '';
                        }
                        const hora = dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                        const tipo = msg.remetente_tipo;

                        // Mensagens de sistema: pílula centralizada (estilo WhatsApp)
                        if (tipo === 'sistema') {
                            html += `
                                <div class="chat-system-row">
                                    <div class="chat-system-pill">${escapeHtml(msg.mensagem || '')}<span class="chat-system-time">${hora}</span></div>
                                </div>`;
                            prevTipo = 'sistema';
                            prevNome = '';
                            return;
                        }

                        const lado = tipo === 'tecnico' ? 'from-tech' : 'from-user';
                        const nome = msg.remetente_nome || (tipo === 'tecnico' ? 'Atendente' : 'Solicitante');
                        // Agrupar mensagens consecutivas do mesmo remetente
                        const agrupado = (tipo === prevTipo && nome === prevNome);
                        prevTipo = tipo;
                        prevNome = nome;
                        const grpClass = agrupado ? ' grouped' : ' first';

                        // Esconder placeholders auto-gerados quando há mídia (ex: [image], [audio])
                        const isPlaceholder = msg.media_url && /^\[(image|audio|video|document|ptt|sticker)\]$/.test(String(msg.mensagem || '').trim());
                        const mostraTexto = msg.mensagem && !isPlaceholder;
                        const textoHtml = mostraTexto ? `<div class="chat-bubble-text">${escapeHtml(msg.mensagem)}</div>` : '';
                        const autorHtml = agrupado ? '' : `<div class="chat-bubble-author">${escapeHtml(nome)}</div>`;
                        html += `
                            <div class="chat-message-row ${lado}${grpClass}">
                                <div class="chat-bubble ${lado}${grpClass}">
                                    ${autorHtml}
                                    ${textoHtml}
                                    ${montarMidiaHtml(msg)}
                                    <div class="chat-bubble-time">${hora}</div>
                                </div>
                            </div>`;
                    });
                    chatMessages.innerHTML = html;
                }

                if (chatIsFirstLoad || wasAtBottom) {
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                    chatIsFirstLoad = false;
                }
            } catch (error) {
                console.error('Erro ao carregar mensagens:', error);
            }
        }

        let chatEnviando = false;
        async function enviarMensagemChat(event) {
            event.preventDefault();
            const chamadoId = document.getElementById('chatChamadoId').value;
            const inputMsg = document.getElementById('chatMensagem');
            const mensagem = inputMsg.value.trim();

            if (chatMidiaArquivo) {
                await enviarMidiaChat(chamadoId, chatMidiaArquivo, mensagem);
                return;
            }

            if (!mensagem) return;
            if (chatEnviando) return; // trava reenvio enquanto a mensagem anterior não terminou

            chatEnviando = true;
            const btnEnviar = document.querySelector('.chat-send-btn');
            if (btnEnviar) btnEnviar.disabled = true;

            // Limpar o campo IMEDIATAMENTE (feedback instantâneo — evita reenvio por impaciência)
            inputMsg.value = '';
            autoResizeTextarea(inputMsg);

            try {
                const response = await fetch(`/api/chamados/${chamadoId}/chat/enviar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mensagem })
                });
                const result = await response.json();
                if (result.success) {
                    chatIsFirstLoad = true;
                    await carregarMensagensChat(chamadoId);
                    if (result.assumiu) {
                        const c = chamadosState.find(item => Number(item.id) === Number(chamadoId));
                        if (c) {
                            c.status = 'em_atendimento';
                            c.atendente_nome = c.atendente_nome || 'Você';
                        }
                        const btnEncerrarChat = document.getElementById('btnEncerrarNoChat');
                        if (btnEncerrarChat) btnEncerrarChat.style.display = 'flex';
                        atualizarOverviewChamados();
                        carregarBannerMeusChamados();
                    }
                } else {
                    // Falhou — devolver o texto ao campo para o atendente tentar de novo
                    inputMsg.value = mensagem;
                    autoResizeTextarea(inputMsg);
                    mostrarToast('✗ ' + result.message, 'error');
                }
            } catch (error) {
                inputMsg.value = mensagem;
                autoResizeTextarea(inputMsg);
                mostrarToast('✗ Erro ao enviar mensagem', 'error');
                console.error(error);
            } finally {
                chatEnviando = false;
                if (btnEnviar) btnEnviar.disabled = false;
                inputMsg.focus();
            }
        }

        async function enviarMidiaChat(chamadoId, file, legenda) {
            const formData = new FormData();
            formData.append('midia', file);
            if (legenda) formData.append('mensagem', legenda);

            const btnEnviar = document.querySelector('.chat-send-btn');
            btnEnviar.disabled = true;

            try {
                const response = await fetch(`/api/chamados/${chamadoId}/chat/enviar-midia`, {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    document.getElementById('chatMensagem').value = '';
                    autoResizeTextarea(document.getElementById('chatMensagem'));
                    removerMidiaPreview();
                    chatIsFirstLoad = true;
                    await carregarMensagensChat(chamadoId);
                    if (result.assumiu) {
                        const c = chamadosState.find(item => Number(item.id) === Number(chamadoId));
                        if (c) {
                            c.status = 'em_atendimento';
                            c.atendente_nome = c.atendente_nome || 'Você';
                        }
                        const btnEncerrarChat = document.getElementById('btnEncerrarNoChat');
                        if (btnEncerrarChat) btnEncerrarChat.style.display = 'flex';
                        atualizarOverviewChamados();
                        carregarBannerMeusChamados();
                    }
                } else {
                    mostrarToast('✗ ' + result.message, 'error');
                }
            } catch (error) {
                mostrarToast('✗ Erro ao enviar mídia', 'error');
                console.error(error);
            } finally {
                btnEnviar.disabled = false;
            }
        }

        // Verificar mensagens não lidas ao carregar a página
        async function verificarMensagensNaoLidas() {
            const chamados = document.querySelectorAll('[id^="badge-"]');
            
            for (const badge of chamados) {
                const chamadoId = badge.id.replace('badge-', '');
                
                try {
                    const response = await fetch(`/api/chamados/${chamadoId}/chat/nao-lidas`);
                    const result = await response.json();
                    
                    if (result.success && result.total > 0) {
                        badge.textContent = result.total;
                        badge.style.display = 'flex';
                    }
                } catch (error) {
                    console.error(`Erro ao verificar mensagens do chamado ${chamadoId}:`, error);
                }
            }
        }

        // Verificar mensagens não lidas ao carregar e a cada 30 segundos
        verificarMensagensNaoLidas();
        setInterval(verificarMensagensNaoLidas, 30000);

        // Funções para modal de dados WhatsApp
        function mostrarDadosWhatsApp(protocolo, nomeInformado, telInformado, nomeReal, telReal) {
            document.getElementById('modalWhatsApp').style.display = 'flex';
            document.getElementById('whatsProtocolo').textContent = protocolo;
            document.getElementById('whatsNomeInformado').textContent = nomeInformado || 'Não informado';
            document.getElementById('whatsTelInformado').textContent = telInformado || 'Não informado';
            document.getElementById('whatsNomeReal').textContent = nomeReal || 'Não disponível';
            document.getElementById('whatsTelReal').textContent = telReal || 'Não disponível';
        }

        function fecharModalWhatsApp() {
            document.getElementById('modalWhatsApp').style.display = 'none';
        }

        // Funções para modal de detalhes
        function verDetalhes(protocolo, categoria, solicitante, setor, ip, telefone, descricao) {
            document.getElementById('modalDetalhes').style.display = 'flex';
            document.getElementById('detProtocolo').textContent = protocolo;
            document.getElementById('detCategoria').textContent = categoria;
            document.getElementById('detSolicitante').textContent = solicitante;
            document.getElementById('detSetor').textContent = setor;
            document.getElementById('detIP').textContent = ip || 'Não informado';
            document.getElementById('detTelefone').textContent = telefone || 'Não informado';
            document.getElementById('detDescricao').textContent = descricao || 'Sem descrição';
        }

        function fecharModalDetalhes() {
            document.getElementById('modalDetalhes').style.display = 'none';
        }

        // Fechar modais ao clicar fora (exceto chat que tem controle próprio)
        window.addEventListener('click', function(event) {
            if (event.target.classList.contains('modal') && event.target.id !== 'modalChat') {
                event.target.style.display = 'none';
            }
        });

        function verDetalhesPorId(chamadoId) {
            const chamado = chamadosState.find(c => c.id === chamadoId);
            if (!chamado) return;
            document.getElementById('modalDetalhes').style.display = 'flex';
            document.getElementById('detProtocolo').textContent = chamado.protocolo || '';
            document.getElementById('detCategoria').textContent = chamado.categoria || '';
            document.getElementById('detSolicitante').textContent = chamado.solicitante_nome || '';
            document.getElementById('detSetor').textContent = chamado.setor || '';
            document.getElementById('detIP').textContent = chamado.ip_maquina || 'Não informado';
            document.getElementById('detTelefone').textContent = chamado.telefone_contato || 'Não informado';
            document.getElementById('detDescricao').textContent = chamado.descricao || 'Sem descrição';

            // Código impressora
            const impRow = document.getElementById('detImpressoraRow');
            const impVal = chamado.cod_impressora || '';
            if (impVal) {
                document.getElementById('detImpressora').textContent = impVal;
                impRow.style.display = 'block';
            } else {
                impRow.style.display = 'none';
            }

            // Email
            const emailRow = document.getElementById('detEmailRow');
            const emailVal = chamado.email || '';
            if (emailVal) {
                document.getElementById('detEmail').textContent = emailVal;
                emailRow.style.display = 'block';
            } else {
                emailRow.style.display = 'none';
            }

            // CPF
            const cpfRow = document.getElementById('detCpfRow');
            const cpfVal = chamado.cpf_solicitante || '';
            if (cpfVal) {
                document.getElementById('detCpf').textContent = cpfVal;
                cpfRow.style.display = 'block';
            } else {
                cpfRow.style.display = 'none';
            }
        }

        function fecharModalDetalhes() {
            document.getElementById('modalDetalhes').style.display = 'none';
        }

        // Event delegation para botões de detalhes
        document.addEventListener('click', function(event) {
            const btnDetalhes = event.target.closest('.btn-detalhes');
            if (btnDetalhes) {
                verDetalhesPorId(Number(btnDetalhes.dataset.id));
                return;
            }
            if (event.target.classList.contains('modal') && event.target.id !== 'modalChat') {
                event.target.style.display = 'none';
            }
        });
    </script>
</body>
</html>
