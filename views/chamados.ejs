        }

        // Transferir chamado
        let atendentesCache = [];

        async function abrirModalTransferir(id, protocolo) {
            document.getElementById('transferirChamadoId').value = id;
            document.getElementById('transferirProtocolo').textContent = protocolo;
            document.getElementById('obsTransferencia').value = '';
            document.getElementById('novoAtendenteId').value = '';
            document.getElementById('modalTransferir').style.display = 'flex';

            const lista = document.getElementById('listaAtendentesTransferir');
            lista.innerHTML = '<div style="padding:14px;text-align:center;color:#94a3b8;font-size:13px;">Carregando...</div>';

            try {
                const response = await fetch('/api/usuarios/atendentes');
                const result = await response.json();
                if (result.success) {
                    atendentesCache = result.atendentes || [];

                    // Atualizar label
                    const label = document.getElementById('transferirTurnoLabel');
                    if (result.labelTurno) {
                        label.textContent = `Transferir para (${result.labelTurno}):`;
                    }

                    if (atendentesCache.length === 0) {
                        lista.innerHTML = '<div style="padding:16px;text-align:center;color:#94a3b8;font-size:13px;">Nenhum técnico disponível no próximo turno.</div>';
                        return;
                    }

                    const diasNomes = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
                    let html = '';

                    atendentesCache.forEach(a => {
                        // Montar horário resumido (só do dia relevante)
                        let horario = '';
                        if (a.turnos && a.turnos.length > 0) {
                            const hrs = a.turnos.map(t => {
                                const ini = String(t.hora_inicio).slice(0,5);
                                const fim = String(t.hora_fim).slice(0,5);
                                return `${ini} - ${fim}`;
                            });
                            horario = hrs.join(', ');
                        }

                        html += `
                            <div class="transfer-card" data-id="${a.id}" onclick="selecionarAtendente(this, ${a.id})">
                                <div class="transfer-card-name">${escapeHtml(a.nome_completo || a.username)}</div>
                                <div class="transfer-card-info">
                                    <span class="transfer-card-nivel">${a.nivel_acesso}</span>
                                    ${horario ? `<span class="transfer-card-horario">🕐 ${horario}</span>` : ''}
                                </div>
                            </div>`;
                    });

                    lista.innerHTML = html;
                }
            } catch (e) {
                lista.innerHTML = '<div style="padding:14px;text-align:center;color:#ef4444;font-size:13px;">Erro ao carregar técnicos.</div>';
            }
        }

        function selecionarAtendente(el, id) {
            // Desmarcar anterior
            document.querySelectorAll('.transfer-card.selected').forEach(c => c.classList.remove('selected'));
            // Marcar novo
            el.classList.add('selected');
            document.getElementById('novoAtendenteId').value = id;
        }

        function fecharModalTransferir() {
            document.getElementById('modalTransferir').style.display = 'none';
        }

        async function transferirChamado(event) {
            event.preventDefault();
            const chamadoId = document.getElementById('transferirChamadoId').value;
            const novoAtendenteId = document.getElementById('novoAtendenteId').value;
            const observacao = document.getElementById('obsTransferencia').value;

            if (!novoAtendenteId) {
                mostrarToast('Selecione o atendente destino', 'error');
                return;
            }
            if (!observacao || observacao.trim().length < 5) {
                mostrarToast('A observação é obrigatória (mínimo 5 caracteres)', 'error');
                return;
            }

            try {
                const response = await fetch(`/api/chamados/${chamadoId}/transferir`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ novoAtendenteId, observacao })
                });
                const result = await response.json();
                if (result.success) {
                    fecharModalTransferir();
                    mostrarToast('✓ ' + result.message, 'success');
                    await atualizarOverviewChamados();
                } else {
                    mostrarToast('✗ ' + result.message, 'error');
                }
            } catch (error) {
                mostrarToast('✗ Erro ao transferir chamado', 'error');
            }
        }

        let encerrandoChamado = false;
        async function encerrarChamado(event) {
            event.preventDefault();
            if (encerrandoChamado) return; // evita duplo clique

            const chamadoId = document.getElementById('chamadoId').value;
            const observacoes = document.getElementById('observacoes').value;

            encerrandoChamado = true;
            const btnSubmit = document.querySelector('#formEncerrar button[type="submit"]');
            const btnLabelOriginal = btnSubmit ? btnSubmit.textContent : '';
            if (btnSubmit) { btnSubmit.disabled = true; btnSubmit.textContent = 'Encerrando...'; }

            try {
                const response = await fetch(`/api/chamados/${chamadoId}/encerrar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ observacoes })
                });

                const result = await response.json();

                if (result.success) {
                    fecharModalEncerrar();
                    mostrarToast('✓ ' + result.message, 'success');
                    await atualizarOverviewChamados();
                } else {
                    mostrarToast('✗ ' + result.message, 'error');
                }
            } catch (error) {
                mostrarToast('✗ Erro ao encerrar chamado', 'error');
                console.error(error);
            } finally {
                encerrandoChamado = false;
                if (btnSubmit) { btnSubmit.disabled = false; btnSubmit.textContent = btnLabelOriginal; }
            }
        }

        async function carregarMeusAtendimentos() {
            document.getElementById('modalMeusAtendimentos').style.display = 'flex';
            document.getElementById('meusAtendimentosContent').innerHTML = '<p style="text-align: center; color: #64748b;">Carregando...</p>';

            try {
                const response = await fetch('/api/chamados/meus-atendimentos');
                const result = await response.json();

                if (result.success) {
                    if (result.chamados.length === 0) {
                        document.getElementById('meusAtendimentosContent').innerHTML = 
                            '<p style="text-align: center; color: #64748b;">Você ainda não atendeu nenhum chamado.</p>';
                    } else {
                        let html = '<table class="messages-table"><thead><tr>' +
                            '<th>Protocolo</th><th>Solicitante</th><th>Status</th><th>Iniciado em</th><th>Encerrado em</th>' +
                            '</tr></thead><tbody>';

                        result.chamados.forEach(chamado => {
                            const statusBadge = chamado.status === 'em_atendimento' 
                                ? '<span class="badge badge-atendimento">⏳ Em Atendimento</span>'
                                : '<span class="badge success">✅ Finalizado</span>';
                            
                            html += `<tr>
                                <td><strong>${chamado.protocolo}</strong></td>
                                <td>${chamado.solicitante_nome}</td>
                                <td>${statusBadge}</td>
                                <td>${chamado.iniciado_em ? new Date(chamado.iniciado_em).toLocaleString('pt-BR') : '-'}</td>
                                <td>${chamado.encerrado_em ? new Date(chamado.encerrado_em).toLocaleString('pt-BR') : '-'}</td>
                            </tr>`;
                        });

                        html += '</tbody></table>';
                        document.getElementById('meusAtendimentosContent').innerHTML = html;
                    }
                } else {
                    document.getElementById('meusAtendimentosContent').innerHTML = 
                        '<p style="text-align: center; color: #dc2626;">Erro ao carregar atendimentos</p>';
                }
            } catch (error) {
                console.error(error);
                document.getElementById('meusAtendimentosContent').innerHTML = 
                    '<p style="text-align: center; color: #dc2626;">Erro ao carregar atendimentos</p>';
            }
        }

        function fecharModalMeusAtendimentos() {
            document.getElementById('modalMeusAtendimentos').style.display = 'none';
        }

        // ── Reabrir chamado ──
        function abrirModalReabrir(id, protocolo) {
            document.getElementById('reabrirChamadoId').value = id;
            document.getElementById('reabrirProtocolo').textContent = protocolo;
            document.getElementById('motivoReabrir').value = '';
            document.getElementById('modalReabrir').style.display = 'flex';
        }

        function fecharModalReabrir() {
            document.getElementById('modalReabrir').style.display = 'none';
        }

        async function reabrirChamado(event) {
            event.preventDefault();
            const chamadoId = document.getElementById('reabrirChamadoId').value;
            const motivo = document.getElementById('motivoReabrir').value.trim();

            if (!motivo || motivo.length < 3) {
                mostrarToast('Informe o motivo da reabertura', 'error');
                return;
            }

            try {
                const response = await fetch(`/api/chamados/${chamadoId}/reabrir`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ motivo })
                });
                const result = await response.json();
                if (result.success) {
                    fecharModalReabrir();
                    mostrarToast('✓ ' + result.message, 'success');
                    await atualizarOverviewChamados();
                } else {
                    mostrarToast('✗ ' + result.message, 'error');
                }
            } catch (error) {
                mostrarToast('✗ Erro ao reabrir chamado', 'error');
            }
        }

        // ── Excluir chamado (somente administrador) ──
        async function excluirChamado(id, protocolo) {
            const confirmacao = prompt(
                `⚠️ Excluir o chamado ${protocolo}?\n\nEsta ação NÃO pode ser desfeita. Todas as mensagens do chat também serão removidas.\n\nDigite EXCLUIR para confirmar:`
            );
            if (confirmacao !== 'EXCLUIR') {
                if (confirmacao !== null) mostrarToast('Confirmação inválida. Cancelado.', 'error');
                return;
            }
            try {
                const r = await fetch(`/api/chamados/${id}`, { method: 'DELETE' });
                const d = await r.json();
                if (d.success) {
                    mostrarToast('✓ ' + d.message, 'success');
                    await atualizarOverviewChamados();
                } else {
                    mostrarToast('✗ ' + d.message, 'error');
                }
            } catch (error) {
                mostrarToast('✗ Erro ao excluir chamado', 'error');
            }
        }

    </script>

