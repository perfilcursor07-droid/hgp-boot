    <!-- Modal Transferir Chamado -->
    <div id="modalTransferir" class="modal">
        <div class="modal-content" style="max-width: 520px;">
            <div class="modal-header">
                <h2>🔄 Transferir Chamado</h2>
                <span class="modal-close" onclick="fecharModalTransferir()">&times;</span>
            </div>
            <form id="formTransferir" onsubmit="transferirChamado(event)" style="padding: 20px;">
                <input type="hidden" id="transferirChamadoId" name="chamadoId">
                <input type="hidden" id="novoAtendenteId" name="novoAtendenteId">
                <p style="margin-bottom:16px;">Protocolo: <strong id="transferirProtocolo"></strong></p>
                
                <div class="form-group">
                    <label id="transferirTurnoLabel" style="font-size:13px;color:#64748b;margin-bottom:8px;">Transferir para (próximo turno):</label>
                    <div id="listaAtendentesTransferir" style="max-height:260px;overflow-y:auto;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc;">
                        <div style="padding:14px;text-align:center;color:#94a3b8;font-size:13px;">Carregando...</div>
                    </div>
                </div>

                <div class="form-group" style="margin-top:14px;">
                    <label for="obsTransferencia">Observação (obrigatória) *</label>
                    <textarea id="obsTransferencia" name="obsTransferencia" rows="3" required minlength="5" placeholder="O que já foi feito e por que está transferindo..." style="width: 100%; padding: 10px 12px; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 13.5px; resize: vertical;"></textarea>
                    <small style="color: #64748b; font-size: 11px;">Mínimo 5 caracteres.</small>
                </div>

                <div class="modal-actions" style="margin-top:16px;">
                    <button type="button" onclick="fecharModalTransferir()" class="btn btn-secondary">Cancelar</button>
