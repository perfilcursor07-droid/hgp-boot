<%
    const isSidebarAdmin = typeof isAdmin === 'boolean' ? isAdmin : true;
    const sidebarNivelAcesso = typeof nivelAcesso !== 'undefined' ? nivelAcesso : (typeof role !== 'undefined' && role === 'Administrador' ? 'administrador' : 'gerenciador');
    const isSidebarAdminOnly = sidebarNivelAcesso === 'administrador';
    const sidebarRole = typeof role !== 'undefined' ? role : (sidebarNivelAcesso === 'administrador' ? 'Administrador' : (sidebarNivelAcesso === 'gerenciador' ? 'Gerenciador' : 'Gestor'));
    const userInitial = typeof username === 'string' && username.length ? username.charAt(0).toUpperCase() : 'U';

    const svgIcons = {
        dashboard: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>',
        chamados: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>',
        messages: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
        conversas: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>',
        tv: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>',
        unidades: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9h.01"/><path d="M9 12h.01"/><path d="M9 15h.01"/><path d="M9 18h.01"/></svg>',
        instancias: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="8" rx="2"/><rect x="2" y="13" width="20" height="8" rx="2"/><line x1="6" y1="7" x2="6.01" y2="7"/><line x1="6" y1="17" x2="6.01" y2="17"/></svg>',
        flows: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><path d="M9 6h6a3 3 0 0 1 3 3v6"/></svg>',
        contacts: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
        usuarios: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
        turnos: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
        escala: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>',
        fluxo: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="3"/><line x1="12" y1="8" x2="12" y2="12"/><path d="M8 16l4-4 4 4"/><circle cx="8" cy="19" r="2"/><circle cx="16" cy="19" r="2"/><line x1="8" y1="17" x2="8" y2="16"/><line x1="16" y1="17" x2="16" y2="16"/></svg>',
        relatorios: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/></svg>',
        settings: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
        avaliacoes: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
        'meus-chamados': '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M12 11v6"/><path d="M9 14h6"/></svg>'
    };

    const menuSections = [
        {
            label: 'Principal',
            items: [
                { key: 'dashboard', href: '/dashboard', label: 'Dashboard', visible: isSidebarAdmin },
                { key: 'chamados', href: '/chamados', label: 'Chamados', visible: true },
                { key: 'meus-chamados', href: '/meus-chamados', label: 'Meus Chamados', visible: true }
            ]
        },
        {
            label: 'Comunicação',
            items: [
                { key: 'tv', href: '/tv', label: 'TV — Chamados', visible: true },
                { key: 'messages', href: '/messages', label: 'Mensagens', visible: isSidebarAdmin },
                { key: 'contacts', href: '/contacts', label: 'Contatos', visible: isSidebarAdminOnly }
            ]
        },
        {
            label: 'Gestão',
            items: [
                { key: 'usuarios', href: '/usuarios', label: 'Usuários', visible: isSidebarAdmin },
                { key: 'turnos', href: '/turnos', label: 'Turnos', visible: isSidebarAdmin },
                { key: 'escala', href: '/escala', label: 'Escala', visible: isSidebarAdmin },
                { key: 'relatorios', href: '/relatorios', label: 'Relatórios', visible: isSidebarAdmin }
            ]
        },
        {
            label: 'Multi-Instância',
            items: [
                { key: 'unidades',   href: '/unidades',   label: 'Unidades',   visible: isSidebarAdminOnly },
                { key: 'flows',      href: '/flows',      label: 'Fluxos', visible: isSidebarAdminOnly },
                { key: 'instancias', href: '/instancias', label: 'Instâncias', visible: isSidebarAdmin }
            ]
        },
        {
            label: 'Sistema',
            items: [
                { key: 'avaliacoes', href: '/avaliacoes', label: 'Avaliações', visible: isSidebarAdmin },
                { key: 'settings', href: '/settings', label: 'Configurações', visible: isSidebarAdminOnly }
            ]
        }
    ];
%>

<style>
    /* ── Sidebar compactado para evitar scroll ──────────────────────── */
    .sidebar-header { padding: 6px 8px 4px !important; }
    .sidebar-header h1 { font-size: 14px !important; }
    .sidebar-kicker { font-size: 9px !important; }
    .sidebar-brand-mark { width: 32px !important; height: 32px !important; }

    .sidebar-menu { gap: 0 !important; padding: 0 6px !important; }
    .menu-section { padding-bottom: 2px !important; margin-bottom: 0 !important; gap: 0 !important; }
    .menu-section-label { padding: 4px 10px 1px !important; font-size: 8px !important; letter-spacing: 0.12em !important; }

    .menu-item { padding: 4px 28px 4px 8px !important; font-size: 11.5px !important; gap: 6px !important; border-radius: 6px !important; }
    .menu-item-icon { width: 22px !important; height: 22px !important; border-radius: 5px !important; }
    .menu-item-icon svg { width: 13px !important; height: 13px !important; }

    .menu-live-badge { right: 8px !important; min-width: 18px !important; height: 18px !important; padding: 0 5px !important; font-size: 10px !important; }

    .sidebar-footer { padding: 4px 6px 6px !important; gap: 4px !important; }
    .user-info { padding: 6px 8px !important; gap: 8px !important; }
    .user-avatar { width: 28px !important; height: 28px !important; font-size: 12px !important; }
    .user-name { font-size: 12px !important; }
    .user-role { font-size: 10px !important; }
    .sidebar-version { font-size: 9px !important; padding: 2px 8px !important; }
    .user-dropdown-item { font-size: 12px !important; padding: 7px 10px !important; }
</style>

<aside class="sidebar">
    <div class="sidebar-shell">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <div class="sidebar-brand-mark">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                </div>
                <div class="sidebar-brand-copy">
                    <span class="sidebar-kicker">Node Control</span>
                    <h1>WhatsApp HGP</h1>
                </div>
            </div>
        </div>

        <nav class="sidebar-menu">
            <% menuSections.forEach((section) => { %>
                <% const visibleItems = section.items.filter(i => i.visible); %>
                <% if (visibleItems.length > 0) { %>
                    <div class="menu-section">
                        <span class="menu-section-label"><%= section.label %></span>
                        <% visibleItems.forEach((item) => { %>
                            <a href="<%= item.href %>" class="menu-item <%= activePage === item.key ? 'active' : '' %>">
                                <span class="menu-item-icon"><%- svgIcons[item.key] || '' %></span>
                                <span class="menu-item-content">
                                    <span class="menu-item-title"><%= item.label %></span>
                                </span>
                                <% if (item.key === 'chamados') { %>
                                    <span class="menu-live-badge" id="pendingChamadosBadge" style="display: <%= pendingChamadosCount > 0 ? 'inline-flex' : 'none' %>;"><%= pendingChamadosCount > 99 ? '99+' : pendingChamadosCount %></span>
                                <% } %>
                            </a>
                        <% }); %>
                    </div>
                <% } %>
            <% }); %>
        </nav>

        <div class="sidebar-footer">
            <div class="user-info" id="userInfoArea" onclick="toggleUserDropdown(event)">
                <div class="user-avatar"><%= userInitial %></div>
                <div class="user-details">
                    <div class="user-name"><%= username %></div>
                    <div class="user-role"><%= sidebarRole %></div>
                </div>
                <svg class="user-dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="user-dropdown" id="userDropdown">
                <button class="user-dropdown-item" onclick="abrirModalPerfil()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span>Editar Dados</span>
                </button>
                <a href="/logout" class="user-dropdown-item user-dropdown-logout">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span>Sair</span>
                </a>
            </div>
            <div class="sidebar-version">
                <span>v2.0</span>
                <span>·</span>
                <span>Erick Vinicius</span>
            </div>
        </div>
    </div>
</aside>

<button class="sidebar-toggle-btn" id="sidebarToggleBtn" onclick="toggleDesktopSidebar()" title="Recolher/expandir menu" aria-label="Recolher ou expandir menu lateral">
    <svg class="toggle-chevron" width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 2L2 8L8 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
</button>

<div class="sidebar-overlay" onclick="document.body.classList.remove('sidebar-open')"></div>

<!-- Modal Editar Perfil -->
<div class="modal-overlay" id="modalPerfil" style="display:none;">
    <div class="modal-box" style="max-width:440px;">
        <div class="modal-header">
            <h3>Editar Dados</h3>
            <span class="modal-close" onclick="fecharModalPerfil()">&times;</span>
        </div>
        <form id="formPerfil" onsubmit="salvarPerfil(event)">
            <div class="form-group">
                <label for="perfilNome">Nome Completo</label>
                <input type="text" id="perfilNome" name="nome_completo" placeholder="Seu nome completo" style="width:100%;padding:10px;border:2px solid #e2e8f0;border-radius:8px;">
            </div>
            <div class="form-group">
                <label for="perfilTelefone">Telefone</label>
                <input type="text" id="perfilTelefone" name="telefone" placeholder="(00) 00000-0000" style="width:100%;padding:10px;border:2px solid #e2e8f0;border-radius:8px;">
            </div>
            <hr style="border:none;border-top:1px solid #e2e8f0;margin:16px 0;">
            <p style="font-size:13px;color:#64748b;margin-bottom:12px;">Deixe em branco se não quiser alterar a senha.</p>
            <div class="form-group">
                <label for="perfilSenhaAtual">Senha Atual</label>
                <input type="password" id="perfilSenhaAtual" name="senha_atual" placeholder="Digite a senha atual" style="width:100%;padding:10px;border:2px solid #e2e8f0;border-radius:8px;">
            </div>
            <div class="form-group">
                <label for="perfilNovaSenha">Nova Senha</label>
                <input type="password" id="perfilNovaSenha" name="nova_senha" placeholder="Nova senha (mín. 4 caracteres)" style="width:100%;padding:10px;border:2px solid #e2e8f0;border-radius:8px;">
            </div>
            <div class="modal-actions" style="margin-top:16px;display:flex;gap:10px;justify-content:flex-end;">
                <button type="button" onclick="fecharModalPerfil()" class="btn btn-secondary" style="padding:10px 20px;border-radius:8px;border:1px solid #e2e8f0;background:#f8fafc;cursor:pointer;">Cancelar</button>
                <button type="submit" class="btn btn-primary" style="padding:10px 20px;border-radius:8px;border:none;background:#25d366;color:#fff;font-weight:600;cursor:pointer;">Salvar</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        function toggleDesktopSidebar() {
            document.body.classList.toggle('sidebar-collapsed');
            const collapsed = document.body.classList.contains('sidebar-collapsed');
            localStorage.setItem('sidebar-collapsed', collapsed ? '1' : '0');
        }

        function aplicarPreferenciaSidebar() {
            if (localStorage.getItem('sidebar-collapsed') === '1') {
                document.body.classList.add('sidebar-collapsed');
            }
        }

        window.toggleDesktopSidebar = toggleDesktopSidebar;

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', aplicarPreferenciaSidebar, { once: true });
        } else {
            aplicarPreferenciaSidebar();
        }

        async function iniciarBadgeChamados() {
            const pendingBadge = document.getElementById('pendingChamadosBadge');
            if (!pendingBadge) return;

            async function atualizarBadgeChamados() {
                try {
                    const response = await fetch(`/api/chamados/pending-count?t=${Date.now()}`, { cache: 'no-store' });
                    if (!response.ok) return;
                    const result = await response.json();
                    if (!result.success) return;
                    const total = Number(result.total || 0);
                    if (total > 0) {
                        pendingBadge.textContent = total > 99 ? '99+' : String(total);
                        pendingBadge.style.display = 'inline-flex';
                    } else {
                        pendingBadge.style.display = 'none';
                    }
                } catch (e) {}
            }

            await atualizarBadgeChamados();
            setInterval(atualizarBadgeChamados, 5000);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', iniciarBadgeChamados, { once: true });
        } else {
            iniciarBadgeChamados();
        }

        // Dropdown do usuário
        window.toggleUserDropdown = function(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('userDropdown');
            dropdown.classList.toggle('open');
        };

        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('userDropdown');
            const userArea = document.getElementById('userInfoArea');
            if (dropdown && !userArea.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });

        // Modal Perfil
        window.abrirModalPerfil = async function() {
            document.getElementById('userDropdown').classList.remove('open');
            document.getElementById('modalPerfil').style.display = 'flex';
            // Carregar dados do perfil
            try {
                const response = await fetch('/api/perfil');
                const result = await response.json();
                if (result.success) {
                    document.getElementById('perfilNome').value = result.usuario.nome_completo || '';
                    document.getElementById('perfilTelefone').value = result.usuario.telefone || '';
                }
            } catch (e) {
                console.error('Erro ao carregar perfil:', e);
            }
            document.getElementById('perfilSenhaAtual').value = '';
            document.getElementById('perfilNovaSenha').value = '';
        };

        window.fecharModalPerfil = function() {
            document.getElementById('modalPerfil').style.display = 'none';
        };

        window.salvarPerfil = async function(event) {
            event.preventDefault();
            const nome_completo = document.getElementById('perfilNome').value.trim();
            const telefone = document.getElementById('perfilTelefone').value.trim();
            const senha_atual = document.getElementById('perfilSenhaAtual').value;
            const nova_senha = document.getElementById('perfilNovaSenha').value;

            if (nova_senha && !senha_atual) {
                alert('Informe a senha atual para alterar a senha.');
                return;
            }

            if (nova_senha && nova_senha.length < 4) {
                alert('A nova senha deve ter pelo menos 4 caracteres.');
                return;
            }

            try {
                const body = { nome_completo, telefone };
                if (nova_senha) {
                    body.senha_atual = senha_atual;
                    body.nova_senha = nova_senha;
                }

                const response = await fetch('/api/perfil', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });

                const result = await response.json();
                if (result.success) {
                    alert('Perfil atualizado com sucesso!');
                    fecharModalPerfil();
                    // Atualizar nome na sidebar se mudou
                    if (nome_completo) {
                        const nameEl = document.querySelector('.user-name');
                        if (nameEl) nameEl.textContent = nome_completo;
                    }
                } else {
                    alert(result.message || 'Erro ao atualizar perfil');
                }
            } catch (e) {
                alert('Erro ao salvar perfil. Tente novamente.');
            }
        };
    })();
</script>
