<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Unidades - HGP</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .un-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
        .un-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; position: relative; overflow: hidden; }
        .un-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; background: var(--cor); }
        .un-card h3 { font-size: 16px; color: #1e293b; margin-bottom: 4px; }
        .un-card .un-code { font-size: 11px; color: #64748b; font-family: monospace; background: #f1f5f9; padding: 2px 8px; border-radius: 4px; display: inline-block; margin-bottom: 8px; }
        .un-card .un-desc { font-size: 12px; color: #475569; margin: 8px 0; min-height: 36px; }
        .un-card .un-stats { display: flex; gap: 12px; margin-top: 10px; padding-top: 10px; border-top: 1px solid #f1f5f9; }
        .un-stat { font-size: 11px; color: #64748b; }
        .un-stat strong { color: #0f172a; font-size: 14px; display: block; }
        .un-card .un-actions { display: flex; gap: 6px; margin-top: 10px; }
        .un-btn { padding: 6px 10px; font-size: 11px; border-radius: 6px; border: 1px solid #e2e8f0; background: #f8fafc; cursor: pointer; flex: 1; font-weight: 600; }
        .un-btn:hover { background: #e2e8f0; }
        .un-btn.danger { color: #dc2626; }
        .un-btn.primary { background: #25d366; color: #fff; border-color: #25d366; }
        .un-inactive { opacity: 0.5; }
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center; }
        .modal-overlay.open { display: flex; }
        .modal-box { background: #fff; border-radius: 12px; max-width: 500px; width: 90%; max-height: 90vh; overflow-y: auto; padding: 20px; }
        .modal-box h3 { margin-bottom: 14px; }
        .form-row { margin-bottom: 12px; }
        .form-row label { display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; }
        .form-row input, .form-row textarea { width: 100%; padding: 8px 10px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 13px; }
        .form-row textarea { resize: vertical; min-height: 60px; }
        .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
        .btn-secondary { padding: 8px 14px; border: 1px solid #e2e8f0; background: #f8fafc; border-radius: 6px; cursor: pointer; font-size: 13px; }
        .btn-primary { padding: 8px 14px; border: none; background: #25d366; color: #fff; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; }
        .admin-list { max-height: 300px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px; }
        .admin-row { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 6px; cursor: pointer; font-size: 12px; }
        .admin-row:hover { background: #f8fafc; }
        .admin-row input[type="checkbox"] { width: auto; }
    </style>
</head>
<body>
    <% const isAdminUI = nivelAcesso === 'administrador'; %>
    <div class="dashboard">
        <%- include('partials/sidebar', { activePage: 'unidades', username, role: 'Administrador', isAdmin: isAdminUI, nivelAcesso }) %>
        <main class="main-content">
            <div class="topbar">
                <div class="topbar-title-group">
                    <button class="menu-toggle" onclick="document.body.classList.toggle('sidebar-open')"><span></span><span></span><span></span></button>
                    <h2>Unidades</h2>
                </div>
                <div class="topbar-actions">
                    <button class="btn-primary" onclick="abrirModalNova()">+ Nova Unidade</button>
                </div>
            </div>
            <div class="content">
                <p style="color:#64748b;font-size:13px;margin-bottom:14px;">Gerencie as unidades atendidas. Cada unidade pode ter sua própria instância de WhatsApp e técnicos vinculados.</p>
                <div class="un-grid" id="unidadesGrid"></div>
            </div>
        </main>
    </div>

    <div class="modal-overlay" id="modalUnidade">
        <div class="modal-box">
            <h3 id="modalTitle">Nova Unidade</h3>
            <form onsubmit="salvarUnidade(event)">
                <input type="hidden" id="unId">
                <div class="form-row">
                    <label>Nome *</label>
                    <input type="text" id="unNome" required>
                </div>
                <div class="form-row">
                    <label>Código *</label>
                    <input type="text" id="unCodigo" required placeholder="HGP, HRT, etc.">
                </div>
                <div class="form-row">
                    <label>Descrição</label>
                    <textarea id="unDescricao"></textarea>
                </div>
                <div class="form-row">
                    <label>Cor</label>
                    <input type="color" id="unCor" value="#25d366">
                </div>
                <div class="form-row">
                    <label><input type="checkbox" id="unAtivo" checked style="width:auto"> Ativa</label>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary" onclick="fecharModal('modalUnidade')">Cancelar</button>
                    <button type="submit" class="btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal-overlay" id="modalAdmins">
        <div class="modal-box">
            <h3>Vincular Técnicos — <span id="adminsUnidadeNome"></span></h3>
            <p style="font-size:12px;color:#64748b;margin-bottom:10px;">Selecione os técnicos/gestores que atendem chamados desta unidade.</p>
            <input type="hidden" id="adminsUnidadeId">
            <div class="admin-list" id="adminList"></div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="fecharModal('modalAdmins')">Cancelar</button>
                <button type="button" class="btn-primary" onclick="salvarAdminsVinc()">Salvar Vínculos</button>
            </div>
        </div>
    </div>

    <script>
        let unidades = <%- JSON.stringify(unidades) %>;

        function escapeHtml(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

        function render() {
            const grid = document.getElementById('unidadesGrid');
            if (unidades.length === 0) {
                grid.innerHTML = '<p style="color:#64748b;text-align:center;padding:40px;grid-column:1/-1;">Nenhuma unidade cadastrada.</p>';
                return;
            }
            grid.innerHTML = unidades.map(u => `
                <div class="un-card ${u.ativo ? '' : 'un-inactive'}" style="--cor:${u.cor || '#25d366'}">
                    <h3>${escapeHtml(u.nome)}</h3>
                    <span class="un-code">${escapeHtml(u.codigo)}</span>
                    <div class="un-desc">${escapeHtml(u.descricao || 'Sem descrição')}</div>
                    <div class="un-stats">
                        <div class="un-stat"><strong>${u.total_admins || 0}</strong>Técnicos</div>
                        <div class="un-stat"><strong>${u.total_instancias || 0}</strong>Instâncias</div>
                    </div>
                    <div class="un-actions">
                        <button class="un-btn" onclick="editarUnidade(${u.id})">Editar</button>
                        <button class="un-btn primary" onclick="abrirAdmins(${u.id},'${escapeHtml(u.nome).replace(/'/g,"\\'")}')">Técnicos</button>
                        <button class="un-btn danger" onclick="excluir(${u.id})">×</button>
                    </div>
                </div>
            `).join('');
        }

        async function recarregar() {
            location.reload();
        }

        function abrirModalNova() {
            document.getElementById('modalTitle').textContent = 'Nova Unidade';
            document.getElementById('unId').value = '';
            document.getElementById('unNome').value = '';
            document.getElementById('unCodigo').value = '';
            document.getElementById('unDescricao').value = '';
            document.getElementById('unCor').value = '#25d366';
            document.getElementById('unAtivo').checked = true;
            document.getElementById('modalUnidade').classList.add('open');
        }

        function editarUnidade(id) {
            const u = unidades.find(x => x.id === id);
            if (!u) return;
            document.getElementById('modalTitle').textContent = 'Editar Unidade';
            document.getElementById('unId').value = u.id;
            document.getElementById('unNome').value = u.nome;
            document.getElementById('unCodigo').value = u.codigo;
            document.getElementById('unDescricao').value = u.descricao || '';
            document.getElementById('unCor').value = u.cor || '#25d366';
            document.getElementById('unAtivo').checked = !!u.ativo;
            document.getElementById('modalUnidade').classList.add('open');
        }

        function fecharModal(id) {
            document.getElementById(id).classList.remove('open');
        }

        async function salvarUnidade(ev) {
            ev.preventDefault();
            const id = document.getElementById('unId').value;
            const body = {
                nome: document.getElementById('unNome').value.trim(),
                codigo: document.getElementById('unCodigo').value.trim().toUpperCase(),
                descricao: document.getElementById('unDescricao').value.trim(),
                cor: document.getElementById('unCor').value,
                ativo: document.getElementById('unAtivo').checked
            };
            try {
                const r = await fetch(id ? `/api/unidades/${id}` : '/api/unidades', {
                    method: id ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const d = await r.json();
                if (d.success) {
                    fecharModal('modalUnidade');
                    location.reload();
                } else {
                    alert(d.message || 'Erro');
                }
            } catch (e) { alert('Erro: ' + e.message); }
        }

        async function excluir(id) {
            if (!confirm('Excluir esta unidade?')) return;
            try {
                const r = await fetch(`/api/unidades/${id}`, { method: 'DELETE' });
                const d = await r.json();
                if (d.success) location.reload();
                else alert(d.message);
            } catch (e) { alert(e.message); }
        }

        async function abrirAdmins(id, nome) {
            document.getElementById('adminsUnidadeId').value = id;
            document.getElementById('adminsUnidadeNome').textContent = nome;
            document.getElementById('modalAdmins').classList.add('open');
            document.getElementById('adminList').innerHTML = '<p style="color:#64748b;padding:20px;text-align:center;">Carregando...</p>';
            try {
                const r = await fetch(`/api/unidades/${id}/admins`);
                const d = await r.json();
                if (!d.success) { alert(d.message); return; }
                const vincIds = new Set(d.vinculados.map(v => v.id));
                document.getElementById('adminList').innerHTML = d.todos.map(a => `
                    <label class="admin-row">
                        <input type="checkbox" value="${a.id}" ${vincIds.has(a.id) ? 'checked' : ''}>
                        <span style="flex:1">${escapeHtml(a.nome_completo || a.username)}</span>
                        <span style="font-size:10px;color:#94a3b8;text-transform:uppercase;">${a.nivel_acesso}</span>
                    </label>
                `).join('');
            } catch (e) { alert(e.message); }
        }

        async function salvarAdminsVinc() {
            const id = document.getElementById('adminsUnidadeId').value;
            const checks = document.querySelectorAll('#adminList input[type="checkbox"]:checked');
            const ids = Array.from(checks).map(c => Number(c.value));
            try {
                const r = await fetch(`/api/unidades/${id}/admins`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ admin_ids: ids })
                });
                const d = await r.json();
                if (d.success) {
                    fecharModal('modalAdmins');
                    location.reload();
                } else alert(d.message);
            } catch (e) { alert(e.message); }
        }

        render();
    </script>
</body>
</html>
