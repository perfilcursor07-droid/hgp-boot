<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuários - WhatsApp SESAU</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .usr-hero {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border-radius: 12px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 12px;
            border: 1px solid rgba(99,102,241,0.15);
        }
        .usr-hero .eyebrow {
            color: #94a3b8;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            margin: 0;
        }
        .usr-hero h1 {
            color: #f1f5f9;
            font-size: 18px;
            font-weight: 800;
            margin: 2px 0 0;
        }
        .usr-hero-actions { display: flex; gap: 8px; align-items: center; }
        .usr-btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 16px;
            background: #22c55e;
            color: #fff;
            border: none;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
            box-shadow: 0 2px 8px rgba(34,197,94,0.25);
        }
        .usr-btn-primary:hover { background: #16a34a; }

        .usr-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .usr-stat {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px 14px;
            border-left: 3px solid #94a3b8;
        }
        .usr-stat.s-total { border-left-color: #334155; }
        .usr-stat.s-admin { border-left-color: #8b5cf6; }
        .usr-stat.s-gestor { border-left-color: #f59e0b; }
        .usr-stat.s-ativo { border-left-color: #22c55e; }
        .usr-stat h3 {
            font-size: 22px;
            font-weight: 800;
            margin: 0 0 2px;
            line-height: 1;
            color: #0f172a;
        }
        .usr-stat p {
            margin: 0;
            font-size: 10px;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .usr-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            overflow: hidden;
        }
        .usr-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            padding: 12px 16px;
            border-bottom: 1px solid #f1f5f9;
        }
        .usr-toolbar h2 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
        }
        .usr-count {
            font-size: 11px;
            font-weight: 600;
            color: #64748b;
            background: #f1f5f9;
            padding: 3px 9px;
            border-radius: 999px;
            margin-left: 8px;
        }
        .usr-search-wrap {
            position: relative;
            min-width: 240px;
            flex: 1;
            max-width: 340px;
        }
        .usr-search-wrap svg {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            pointer-events: none;
        }
        .usr-search {
            width: 100%;
            padding: 8px 12px 8px 34px;
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            font-size: 13px;
            background: #f8fafc;
            font-family: inherit;
            outline: none;
            box-sizing: border-box;
        }
        .usr-search:focus {
            background: #fff;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }

        .usr-table-wrap { overflow-x: auto; }
        .usr-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .usr-table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 9px 12px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
            text-align: left;
        }
        .usr-table tbody td {
            padding: 10px 12px;
            font-size: 13px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            color: #334155;
        }
        .usr-table tbody tr:hover td { background: #f8fafc; }
        .usr-table tbody tr.inactive td { opacity: 0.55; }

        .usr-person {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }
        .usr-avatar {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
        }
        .usr-avatar.admin { background: linear-gradient(135deg, #7c3aed, #a855f7); }
        .usr-avatar.gerenciador { background: linear-gradient(135deg, #2563eb, #3b82f6); }
        .usr-avatar.gestor { background: linear-gradient(135deg, #d97706, #f59e0b); }
        .usr-avatar.visualizador { background: linear-gradient(135deg, #64748b, #94a3b8); }
        .usr-person-info { min-width: 0; }
        .usr-person-name {
            font-weight: 700;
            color: #0f172a;
            font-size: 13px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 200px;
        }
        .usr-person-user {
            font-size: 11px;
            color: #94a3b8;
            font-family: ui-monospace, monospace;
        }

        .usr-meta { font-size: 12px; color: #64748b; white-space: nowrap; }

        .usr-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }
        .usr-chip.admin { background: #ede9fe; color: #6d28d9; }
        .usr-chip.gerenciador { background: #dbeafe; color: #1d4ed8; }
        .usr-chip.gestor { background: #fef3c7; color: #b45309; }
        .usr-chip.visualizador { background: #f1f5f9; color: #475569; }
        .usr-chip.ativo { background: #dcfce7; color: #15803d; }
        .usr-chip.inativo { background: #fee2e2; color: #b91c1c; }

        .usr-unidades {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            max-width: 180px;
        }
        .usr-unidade-tag {
            font-size: 10px;
            font-weight: 700;
            background: #f1f5f9;
            color: #475569;
            padding: 2px 7px;
            border-radius: 5px;
        }
        .usr-unidade-all { color: #94a3b8; font-size: 12px; font-style: italic; }

        .usr-actions {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .usr-act {
            width: 30px;
            height: 30px;
            border-radius: 7px;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            color: #475569;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            transition: all 0.12s;
        }
        .usr-act:hover { background: #fff; transform: scale(1.06); }
        .usr-act svg { width: 14px; height: 14px; }
        .usr-act.edit:hover { border-color: #93c5fd; color: #2563eb; background: #eff6ff; }
        .usr-act.key:hover { border-color: #fcd34d; color: #d97706; background: #fffbeb; }
        .usr-act.lock:hover { border-color: #cbd5e1; color: #334155; background: #f1f5f9; }
        .usr-act.danger { color: #dc2626; border-color: #fecaca; background: #fef2f2; }
        .usr-act.danger:hover { background: #fee2e2; border-color: #fca5a5; }

        .usr-empty {
            text-align: center;
            padding: 40px 20px;
            color: #94a3b8;
            font-size: 13px;
        }

        /* Modal */
        #modalUsuario .modal-content {
            max-width: 560px;
            border-radius: 14px;
            overflow: hidden;
        }
        #modalUsuario .modal-header {
            background: #0f172a;
            color: #fff;
            padding: 14px 18px;
        }
        #modalUsuario .modal-header h2 { color: #fff; font-size: 16px; margin: 0; }
        #modalUsuario .modal-close { color: rgba(255,255,255,0.7); }
        #modalUsuario .modal-close:hover { color: #fff; }
        #modalUsuario form { padding: 18px; }
        #modalUsuario .form-group { margin-bottom: 14px; }
        #modalUsuario .form-group label {
            font-size: 12px;
            font-weight: 700;
            color: #334155;
            margin-bottom: 5px;
        }
        #modalUsuario .form-group input[type="text"],
        #modalUsuario .form-group input[type="password"],
        #modalUsuario .form-group select {
            border-radius: 8px;
            border: 1.5px solid #e2e8f0;
            padding: 9px 12px;
            font-size: 13px;
        }
        #modalUsuario .form-group input:focus,
        #modalUsuario .form-group select:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }
        .usr-check-box {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 6px;
            max-height: 150px;
            overflow-y: auto;
            background: #f8fafc;
        }
        .usr-check-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 8px;
            cursor: pointer;
            font-size: 13px;
            border-radius: 6px;
            color: #334155;
        }
        .usr-check-item:hover { background: #fff; }
        .usr-hint { color: #94a3b8; font-size: 11px; display: block; margin-top: 4px; font-weight: 400; }
        .usr-ativo-row {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            cursor: pointer;
        }
        #modalUsuario .modal-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            padding-top: 8px;
            border-top: 1px solid #f1f5f9;
            margin-top: 4px;
        }

        @media (max-width: 900px) {
            .usr-stats { grid-template-columns: repeat(2, 1fr); }
            .usr-person-name { max-width: 140px; }
        }
        @media (max-width: 640px) {
            .usr-stats { grid-template-columns: 1fr 1fr; }
            .usr-toolbar { flex-direction: column; align-items: stretch; }
            .usr-search-wrap { max-width: none; }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <%- include('partials/sidebar', { activePage: 'usuarios', username, role: nivelAcesso === 'gerenciador' ? 'Gerenciador' : 'Administrador', isAdmin: true, nivelAcesso: nivelAcesso || 'administrador' }) %>

        <main class="main-content">
            <div class="topbar">
                <div class="topbar-title-group">
                    <button class="menu-toggle" onclick="document.body.classList.toggle('sidebar-open')">
                        <span></span><span></span><span></span>
                    </button>
                    <h2>Usuários</h2>
                </div>
            </div>

            <div class="content">
                <section class="usr-hero">
                    <div>
                        <p class="eyebrow">Administração</p>
                        <h1>Gerenciamento de Usuários</h1>
                    </div>
                    <div class="usr-hero-actions">
                        <% if (nivelAcesso === 'administrador' || nivelAcesso === 'gerenciador') { %>
                        <button type="button" onclick="abrirModalNovo()" class="usr-btn-primary">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            Novo Usuário
                        </button>
                        <% } %>
                    </div>
                </section>

                <% if (nivelAcesso === 'administrador') { %>
                <div class="usr-stats">
                    <div class="usr-stat s-total">
                        <h3><%= stats.total %></h3>
                        <p>Total</p>
                    </div>
                    <div class="usr-stat s-admin">
                        <h3><%= stats.administradores %></h3>
                        <p>Administradores</p>
                    </div>
                    <div class="usr-stat s-gestor">
                        <h3><%= stats.gestores %></h3>
                        <p>Gestores</p>
                    </div>
                    <div class="usr-stat s-ativo">
                        <h3><%= stats.ativos %></h3>
                        <p>Ativos</p>
                    </div>
                </div>
                <% } %>

                <div class="usr-card">
                    <div class="usr-toolbar">
                        <div style="display:flex;align-items:center;">
                            <h2>Lista de Usuários</h2>
                            <span class="usr-count" id="usrCount"><%= usuarios.length %></span>
                        </div>
                        <div class="usr-search-wrap">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="search" id="searchInput" class="usr-search" placeholder="Buscar nome, CPF ou usuário...">
                        </div>
                    </div>

                    <div class="usr-table-wrap">
                        <table class="usr-table">
                            <thead>
                                <tr>
                                    <th>Usuário</th>
                                    <th>CPF</th>
                                    <th>Telefone</th>
                                    <th>Nível</th>
                                    <th>Unidades</th>
                                    <th>Status</th>
                                    <th style="text-align:right;">Ações</th>
                                </tr>
                            </thead>
                            <tbody id="usuariosTable">
                                <% if (usuarios.length === 0) { %>
                                    <tr>
                                        <td colspan="7"><div class="usr-empty">Nenhum usuário encontrado.</div></td>
                                    </tr>
                                <% } else { %>
                                    <% usuarios.forEach(usuario => {
                                        const nivel = usuario.nivel_acesso || 'gestor';
                                        const nome = usuario.nome_completo || 'Não informado';
                                        const inicial = String(nome).trim().charAt(0).toUpperCase() || '?';
                                        const nivelLabel = nivel === 'administrador' ? 'Administrador'
                                            : (nivel === 'gerenciador' ? 'Gerenciador'
                                            : (nivel === 'visualizador' ? 'Visualizador' : 'Gestor'));
                                        let unidadeTags = [];
                                        if (nivel === 'administrador') {
                                            unidadeTags = null;
                                        } else if (usuario.unidades_nomes) {
                                            unidadeTags = String(usuario.unidades_nomes).split(',').map(s => s.trim()).filter(Boolean);
                                        }
                                    %>
                                        <tr class="<%= usuario.ativo ? '' : 'inactive' %>" data-search="<%= (nome + ' ' + (usuario.username||'') + ' ' + (usuario.cpf||'')).toLowerCase() %>">
                                            <td>
                                                <div class="usr-person">
                                                    <span class="usr-avatar <%= nivel %>"><%= inicial %></span>
                                                    <div class="usr-person-info">
                                                        <div class="usr-person-name" title="<%= nome %>"><%= nome %></div>
                                                        <div class="usr-person-user">@<%= usuario.username %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="usr-meta"><%= usuario.cpf || '—' %></td>
                                            <td class="usr-meta"><%= usuario.telefone || '—' %></td>
                                            <td><span class="usr-chip <%= nivel %>"><%= nivelLabel %></span></td>
                                            <td>
                                                <% if (unidadeTags === null) { %>
                                                    <span class="usr-unidade-all">Todas</span>
                                                <% } else if (unidadeTags.length === 0) { %>
                                                    <span class="usr-unidade-all">—</span>
                                                <% } else { %>
                                                    <div class="usr-unidades">
                                                        <% unidadeTags.slice(0, 3).forEach(t => { %>
                                                            <span class="usr-unidade-tag"><%= t %></span>
                                                        <% }) %>
                                                        <% if (unidadeTags.length > 3) { %>
                                                            <span class="usr-unidade-tag" title="<%= unidadeTags.join(', ') %>">+<%= unidadeTags.length - 3 %></span>
                                                        <% } %>
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="usr-chip <%= usuario.ativo ? 'ativo' : 'inativo' %>">
                                                    <%= usuario.ativo ? 'Ativo' : 'Inativo' %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="usr-actions" style="justify-content:flex-end;">
                                                <% if (nivelAcesso === 'administrador' || nivelAcesso === 'gerenciador') { %>
                                                <% const isAdminTarget = usuario.nivel_acesso === 'administrador'; %>
                                                <% const podeEditar = nivelAcesso === 'administrador' || !isAdminTarget; %>
                                                <% if (podeEditar) { %>
                                                    <button type="button" onclick="editarUsuario(<%= usuario.id %>)" class="usr-act edit" title="Editar">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                    </button>
                                                    <button type="button" onclick="resetarSenha(<%= usuario.id %>, '<%= usuario.username %>')" class="usr-act key" title="Resetar senha">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                                                    </button>
                                                    <% if (usuario.username !== 'admin') { %>
                                                        <button type="button" onclick="toggleStatus(<%= usuario.id %>, <%= usuario.ativo %>)" class="usr-act lock" title="<%= usuario.ativo ? 'Desativar' : 'Ativar' %>">
                                                            <% if (usuario.ativo) { %>
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                                            <% } else { %>
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
                                                            <% } %>
                                                        </button>
                                                        <button type="button" onclick="excluirUsuario(<%= usuario.id %>)" class="usr-act danger" title="Excluir">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                                        </button>
                                                    <% } %>
                                                <% } else { %>
                                                    <span style="color:#94a3b8;font-size:11px;">—</span>
                                                <% } %>
                                                <% } else { %>
                                                    <span style="color:#94a3b8;font-size:11px;">—</span>
                                                <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Novo/Editar Usuário -->
    <div id="modalUsuario" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Novo Usuário</h2>
                <span class="modal-close" onclick="fecharModal()">&times;</span>
            </div>
            <form id="formUsuario" onsubmit="salvarUsuario(event)">
                <input type="hidden" id="usuarioId" name="id">

                <div class="form-group">
                    <label for="nome_completo">Nome Completo *</label>
                    <input type="text" id="nome_completo" name="nome_completo" required style="text-transform: uppercase;" oninput="this.value = this.value.toUpperCase(); sugerirUsername()">
                </div>

                <div class="form-group">
                    <label for="username">Usuário *</label>
                    <input type="text" id="username" name="username" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="cpf">CPF *</label>
                        <input type="text" id="cpf" name="cpf" required maxlength="14" placeholder="000.000.000-00">
                    </div>
                    <div class="form-group">
                        <label for="telefone">Telefone *</label>
                        <input type="text" id="telefone" name="telefone" required maxlength="15" placeholder="(00) 00000-0000">
                    </div>
                </div>

                <div class="form-group">
                    <label for="nivel_acesso">Nível de Acesso *</label>
                    <select id="nivel_acesso" name="nivel_acesso" required>
                        <option value="gestor">Gestor (Acesso apenas a Chamados)</option>
                        <option value="gerenciador">Gerenciador</option>
                        <% if (nivelAcesso === 'administrador') { %>
                        <option value="administrador">Administrador (Acesso Total)</option>
                        <% } %>
                        <option value="visualizador">Visualizador (Somente Leitura)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Unidades vinculadas <small style="font-weight:normal;color:#64748b;">(o usuário só verá chamados dessas unidades)</small></label>
                    <div id="unidadesList" class="usr-check-box">
                        <% if (unidades && unidades.length > 0) { %>
                            <% unidades.forEach(u => { %>
                                <label class="usr-check-item">
                                    <input type="checkbox" name="unidade_ids" value="<%= u.id %>" class="check-unidade" style="width:auto" onchange="carregarLocaisForm()">
                                    <span><strong><%= u.codigo %></strong> — <%= u.nome %></span>
                                </label>
                            <% }) %>
                        <% } else { %>
                            <p style="color:#64748b;font-size:12px;padding:10px;text-align:center;">Nenhuma unidade cadastrada. <a href="/unidades">Cadastrar agora</a></p>
                        <% } %>
                    </div>
                    <span class="usr-hint">Administradores sempre veem todas as unidades. Os checkboxes valem para gerenciador, gestor e visualizador.</span>
                </div>

                <div class="form-group" id="locaisFormGroup" style="display:none;">
                    <label>Locais vinculados <small style="font-weight:normal;color:#64748b;">(vazio = todos da unidade)</small></label>
                    <div id="locaisList" class="usr-check-box">
                        <p style="color:#94a3b8;font-size:12px;text-align:center;padding:10px;">Selecione uma unidade acima</p>
                    </div>
                    <span class="usr-hint">Se nenhum local for marcado, o usuário verá todos os chamados da unidade.</span>
                </div>

                <div class="form-group">
                    <label for="password">Senha <span id="senhaOpcional" style="color:#64748b;font-weight:normal;">(deixe em branco para manter a atual)</span></label>
                    <input type="password" id="password" name="password" minlength="6">
                </div>

                <div class="form-group">
                    <label class="usr-ativo-row">
                        <input type="checkbox" id="ativo" name="ativo" checked style="width:auto">
                        Usuário ativo
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" onclick="fecharModal()" class="btn btn-secondary">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#usuariosTable tr[data-search]');
            let visible = 0;
            rows.forEach(row => {
                const text = row.getAttribute('data-search') || row.textContent.toLowerCase();
                const show = !searchTerm || text.includes(searchTerm);
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            const countEl = document.getElementById('usrCount');
            if (countEl) countEl.textContent = visible;
        });

        document.getElementById('cpf').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length <= 11) {
                value = value.replace(/(\d{3})(\d)/, '$1.$2');
                value = value.replace(/(\d{3})(\d)/, '$1.$2');
                value = value.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
                e.target.value = value;
            }
        });

        document.getElementById('telefone').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length <= 11) {
                value = value.replace(/^(\d{2})(\d)/g, '($1) $2');
                value = value.replace(/(\d)(\d{4})$/, '$1-$2');
                e.target.value = value;
            }
        });

        function abrirModalNovo() {
            document.getElementById('modalTitle').textContent = 'Novo Usuário';
            document.getElementById('formUsuario').reset();
            document.getElementById('usuarioId').value = '';
            document.getElementById('password').required = true;
            document.getElementById('senhaOpcional').style.display = 'none';
            document.querySelectorAll('.check-unidade').forEach(cb => cb.checked = false);
            locaisVinculadosUsuario = [];
            document.getElementById('locaisFormGroup').style.display = 'none';
            document.getElementById('locaisList').innerHTML = '<p style="color:#94a3b8;font-size:12px;text-align:center;padding:10px;">Selecione uma unidade acima</p>';
            usernameEditadoManual = false;
            document.getElementById('modalUsuario').style.display = 'flex';
        }

        function fecharModal() {
            document.getElementById('modalUsuario').style.display = 'none';
        }

        async function editarUsuario(id) {
            try {
                const response = await fetch(`/api/usuarios/${id}`);
                const data = await response.json();

                if (data.success) {
                    document.getElementById('modalTitle').textContent = 'Editar Usuário';
                    document.getElementById('usuarioId').value = data.usuario.id;
                    document.getElementById('nome_completo').value = data.usuario.nome_completo || '';
                    document.getElementById('username').value = data.usuario.username;
                    document.getElementById('cpf').value = data.usuario.cpf || '';
                    document.getElementById('telefone').value = data.usuario.telefone || '';
                    document.getElementById('nivel_acesso').value = data.usuario.nivel_acesso;
                    document.getElementById('ativo').checked = data.usuario.ativo;
                    document.getElementById('password').required = false;
                    document.getElementById('password').value = '';
                    document.getElementById('senhaOpcional').style.display = 'inline';

                    const vincSet = new Set((data.usuario.unidade_ids || []).map(Number));
                    document.querySelectorAll('.check-unidade').forEach(cb => {
                        cb.checked = vincSet.has(Number(cb.value));
                    });

                    try {
                        const locRes = await fetch(`/api/usuarios/${id}/locais`);
                        const locData = await locRes.json();
                        locaisVinculadosUsuario = locData.success ? locData.locais.map(l => l.local_id) : [];
                    } catch (e) {
                        locaisVinculadosUsuario = [];
                    }
                    await carregarLocaisForm();

                    document.getElementById('modalUsuario').style.display = 'flex';
                } else {
                    alert('Erro ao carregar usuário');
                }
            } catch (error) {
                alert('Erro ao carregar usuário');
                console.error(error);
            }
        }

        async function salvarUsuario(event) {
            event.preventDefault();

            const formData = new FormData(event.target);
            const unidadeIds = Array.from(document.querySelectorAll('.check-unidade:checked')).map(cb => Number(cb.value));
            const localIds = Array.from(document.querySelectorAll('.check-local:checked')).map(cb => Number(cb.value));
            const data = {
                id: formData.get('id'),
                nome_completo: formData.get('nome_completo'),
                username: formData.get('username'),
                cpf: formData.get('cpf'),
                telefone: formData.get('telefone'),
                nivel_acesso: formData.get('nivel_acesso'),
                ativo: formData.get('ativo') === 'on',
                password: formData.get('password'),
                unidade_ids: unidadeIds
            };

            if (!data.nome_completo || !data.username || !data.cpf || !data.telefone || !data.nivel_acesso) {
                alert('Por favor, preencha todos os campos obrigatórios');
                return;
            }

            if (!data.id && (!data.password || data.password.length < 6)) {
                alert('A senha deve ter no mínimo 6 caracteres');
                return;
            }

            try {
                const url = data.id ? `/api/usuarios/${data.id}` : '/api/usuarios';
                const method = data.id ? 'PUT' : 'POST';

                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    const userId = data.id || result.userId;
                    if (userId && localIds.length > 0) {
                        await fetch(`/api/usuarios/${userId}/locais`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ local_ids: localIds })
                        });
                    } else if (userId) {
                        await fetch(`/api/usuarios/${userId}/locais`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ local_ids: [] })
                        });
                    }
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error('Erro completo:', error);
                alert('Erro ao salvar usuário: ' + error.message);
            }
        }

        async function toggleStatus(id, ativoAtual) {
            const acao = ativoAtual ? 'desativar' : 'ativar';
            if (!confirm(`Deseja realmente ${acao} este usuário?`)) return;

            try {
                const response = await fetch(`/api/usuarios/${id}/toggle`, { method: 'PATCH' });
                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Erro ao alterar status do usuário');
                console.error(error);
            }
        }

        async function resetarSenha(id, username) {
            if (!confirm(`Deseja resetar a senha do usuário ${username}?`)) return;

            try {
                const response = await fetch(`/api/usuarios/${id}/reset-password`, { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    alert(`✓ ${result.message}\n\nSenha temporária: ${result.temporaryPassword}`);
                } else {
                    alert('✗ ' + result.message);
                }
            } catch (error) {
                alert('✗ Erro ao resetar senha');
                console.error(error);
            }
        }

        async function excluirUsuario(id) {
            if (!confirm('Deseja realmente excluir este usuário? Esta ação não pode ser desfeita.')) return;

            try {
                const response = await fetch(`/api/usuarios/${id}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Erro ao excluir usuário');
                console.error(error);
            }
        }

        let usernameEditadoManual = false;
        document.getElementById('username').addEventListener('input', function() {
            usernameEditadoManual = true;
        });

        function sugerirUsername() {
            const id = document.getElementById('usuarioId').value;
            if (id) return;
            if (usernameEditadoManual && document.getElementById('username').value.trim() !== '') return;

            const nome = document.getElementById('nome_completo').value.trim();
            if (!nome) return;
            const partes = nome.split(/\s+/).filter(p => p.length > 0);
            if (partes.length === 0) return;
            const primeiro = partes[0].toLowerCase();
            const ultimo = partes.length > 1 ? partes[partes.length - 1].toLowerCase() : '';
            const removerAcento = (s) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
            const sugestao = ultimo ? `${removerAcento(primeiro)}${removerAcento(ultimo)}` : removerAcento(primeiro);
            document.getElementById('username').value = sugestao;
        }

        let locaisVinculadosUsuario = [];

        async function carregarLocaisForm() {
            const unidadeIds = Array.from(document.querySelectorAll('.check-unidade:checked')).map(cb => Number(cb.value));
            const container = document.getElementById('locaisList');
            const group = document.getElementById('locaisFormGroup');

            if (unidadeIds.length === 0) {
                group.style.display = 'none';
                container.innerHTML = '<p style="color:#94a3b8;font-size:12px;text-align:center;padding:10px;">Selecione uma unidade acima</p>';
                return;
            }

            container.innerHTML = '<p style="color:#94a3b8;font-size:12px;text-align:center;padding:10px;">Carregando locais...</p>';
            group.style.display = 'block';

            try {
                let todosLocais = [];
                for (const uid of unidadeIds) {
                    const r = await fetch(`/api/unidades/${uid}/locais`);
                    const d = await r.json();
                    if (d.success && d.locais.length > 0) {
                        todosLocais.push(...d.locais.map(l => ({ ...l, unidade_id: uid })));
                    }
                }

                if (todosLocais.length === 0) {
                    group.style.display = 'none';
                    return;
                }

                const vincSet = new Set(locaisVinculadosUsuario.map(Number));
                container.innerHTML = todosLocais.map(l => `
                    <label class="usr-check-item">
                        <input type="checkbox" class="check-local" value="${l.id}" style="width:auto" ${vincSet.has(l.id) ? 'checked' : ''}>
                        <span>${l.nome}</span>
                    </label>
                `).join('');
            } catch (e) {
                container.innerHTML = '<p style="color:#ef4444;font-size:12px;text-align:center;padding:10px;">Erro ao carregar locais</p>';
            }
        }
    </script>
</body>
</html>
