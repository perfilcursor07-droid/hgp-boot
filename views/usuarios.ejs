<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuários - WhatsApp SESAU</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="dashboard">
        <%- include('partials/sidebar', { activePage: 'usuarios', username, role: nivelAcesso === 'gerenciador' ? 'Gerenciador' : 'Administrador', isAdmin: true, nivelAcesso: nivelAcesso || 'administrador' }) %>

        <!-- Main Content -->
        <main class="main-content">
            <div class="topbar">
                <div class="topbar-title-group">
                    <button class="menu-toggle" onclick="document.body.classList.toggle('sidebar-open')">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <h2>👤 Gerenciamento de Usuários</h2>
                </div>
                <div class="topbar-actions">
                    <% if (nivelAcesso === 'administrador' || nivelAcesso === 'gerenciador') { %>
                    <button onclick="abrirModalNovo()" class="btn btn-primary">➕ Novo Usuário</button>
                    <% } %>
                </div>
            </div>

            <div class="content">
                <!-- Stats -->
                <% if (nivelAcesso === 'administrador') { %>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon blue">👥</div>
                        <div class="stat-info">
                            <h3><%= stats.total %></h3>
                            <p>Total de Usuários</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon purple">🔑</div>
                        <div class="stat-info">
                            <h3><%= stats.administradores %></h3>
                            <p>Administradores</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange">📊</div>
                        <div class="stat-info">
                            <h3><%= stats.gestores %></h3>
                            <p>Gestores</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green">✓</div>
                        <div class="stat-info">
                            <h3><%= stats.ativos %></h3>
                            <p>Usuários Ativos</p>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Tabela de Usuários -->
                <div class="card">
                    <h2>Lista de Usuários</h2>
                    <div style="margin: 16px 0;">
                        <input type="text" id="searchInput" placeholder="🔍 Buscar por nome, CPF ou usuário..." class="search-input">
                    </div>
                    <div class="messages-container">
                        <table class="messages-table">
                            <thead>
                                <tr>
                                    <th>Nome Completo</th>
                                    <th>Usuário</th>
                                    <th>CPF</th>
                                    <th>Telefone</th>
                                    <th>Nível de Acesso</th>
                                    <th>Unidades</th>
                                    <th>Status</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="usuariosTable">
                                <% if (usuarios.length === 0) { %>
                                    <tr>
                                        <td colspan="8" class="no-messages">
                                            Nenhum usuário encontrado.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% usuarios.forEach(usuario => { %>
                                        <tr>
                                            <td><strong><%= usuario.nome_completo || 'Não informado' %></strong></td>
                                            <td><%= usuario.username %></td>
                                            <td><%= usuario.cpf || '-' %></td>
                                            <td><%= usuario.telefone || '-' %></td>
                                            <td>
                                                <span class="badge <%= usuario.nivel_acesso === 'administrador' ? 'badge-admin' : (usuario.nivel_acesso === 'gerenciador' ? 'badge-admin' : (usuario.nivel_acesso === 'visualizador' ? 'badge-viewer' : 'badge-gestor')) %>">
                                                    <%= usuario.nivel_acesso === 'administrador' ? '🔑 Administrador' : (usuario.nivel_acesso === 'gerenciador' ? '🛡️ Gerenciador' : (usuario.nivel_acesso === 'visualizador' ? '👁️ Visualizador' : '📊 Gestor')) %>
                                                </span>
                                            </td>
                                            <td style="font-size:12px;color:#475569;">
                                                <% if (usuario.nivel_acesso === 'administrador') { %>
                                                    <span style="color:#94a3b8;font-style:italic;">Todas</span>
                                                <% } else if (usuario.unidades_nomes) { %>
                                                    <%= usuario.unidades_nomes %>
                                                <% } else { %>
                                                    <span style="color:#cbd5e1;">—</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="badge <%= usuario.ativo ? 'success' : 'badge-inactive' %>">
                                                    <%= usuario.ativo ? '✓ Ativo' : '✗ Inativo' %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if (nivelAcesso === 'administrador' || nivelAcesso === 'gerenciador') { %>
                                                <% const isAdminTarget = usuario.nivel_acesso === 'administrador'; %>
                                                <% const podeEditar = nivelAcesso === 'administrador' || !isAdminTarget; %>
                                                <% if (podeEditar) { %>
                                                    <button onclick="editarUsuario(<%= usuario.id %>)" class="btn-icon" title="Editar">✏️</button>
                                                    <button onclick="resetarSenha(<%= usuario.id %>, '<%= usuario.username %>')" class="btn-icon" title="Resetar senha">🔑</button>
                                                    <% if (usuario.username !== 'admin') { %>
                                                        <button onclick="toggleStatus(<%= usuario.id %>, <%= usuario.ativo %>)" class="btn-icon" title="<%= usuario.ativo ? 'Desativar' : 'Ativar' %>">
                                                            <%= usuario.ativo ? '🔒' : '🔓' %>
                                                        </button>
                                                        <button onclick="excluirUsuario(<%= usuario.id %>)" class="btn-icon btn-danger" title="Excluir">🗑️</button>
                                                    <% } %>
                                                <% } else { %>
                                                    <span style="color:#94a3b8;font-size:11px;">—</span>
                                                <% } %>
                                                <% } else { %>
                                                <span style="color:#94a3b8;font-size:11px;">—</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Novo/Editar Usuário -->
    <div id="modalUsuario" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Novo Usuário</h2>
                <span class="modal-close" onclick="fecharModal()">&times;</span>
            </div>
            <form id="formUsuario" onsubmit="salvarUsuario(event)">
                <input type="hidden" id="usuarioId" name="id">
                
                <div class="form-group">
                    <label for="nome_completo">Nome Completo *</label>
                    <input type="text" id="nome_completo" name="nome_completo" required style="text-transform: uppercase;" oninput="this.value = this.value.toUpperCase(); sugerirUsername()">
                </div>

                <div class="form-group">
                    <label for="username">Usuário *</label>
                    <input type="text" id="username" name="username" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="cpf">CPF *</label>
                        <input type="text" id="cpf" name="cpf" required maxlength="14" placeholder="000.000.000-00">
                    </div>

                    <div class="form-group">
                        <label for="telefone">Telefone *</label>
                        <input type="text" id="telefone" name="telefone" required maxlength="15" placeholder="(00) 00000-0000">
                    </div>
                </div>

                <div class="form-group">
                    <label for="nivel_acesso">Nível de Acesso *</label>
                    <select id="nivel_acesso" name="nivel_acesso" required>
                        <option value="gestor">Gestor (Acesso apenas a Chamados)</option>
                        <option value="gerenciador">Gerenciador</option>
                        <% if (nivelAcesso === 'administrador') { %>
                        <option value="administrador">Administrador (Acesso Total)</option>
                        <% } %>
                        <option value="visualizador">Visualizador (Somente Leitura)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Unidades vinculadas <small style="color:#64748b;font-weight:normal;">(o usuário só verá chamados dessas unidades)</small></label>
                    <div id="unidadesList" style="border:1px solid #e2e8f0;border-radius:8px;padding:8px;max-height:160px;overflow-y:auto;background:#f8fafc;">
                        <% if (unidades && unidades.length > 0) { %>
                            <% unidades.forEach(u => { %>
                                <label style="display:flex;align-items:center;gap:8px;padding:5px 8px;cursor:pointer;font-size:13px;border-radius:5px;" onmouseover="this.style.background='#fff'" onmouseout="this.style.background='transparent'">
                                    <input type="checkbox" name="unidade_ids" value="<%= u.id %>" class="check-unidade" style="width:auto" onchange="carregarLocaisForm()">
                                    <span><strong><%= u.codigo %></strong> — <%= u.nome %></span>
                                </label>
                            <% }) %>
                        <% } else { %>
                            <p style="color:#64748b;font-size:12px;padding:10px;text-align:center;">Nenhuma unidade cadastrada. <a href="/unidades">Cadastrar agora</a></p>
                        <% } %>
                    </div>
                    <% if (nivelAcesso === 'administrador') { %>
                        <small style="color:#94a3b8;display:block;margin-top:4px;">Administradores sempre veem todas as unidades.</small>
                    <% } %>
                </div>

                <div class="form-group" id="locaisFormGroup" style="display:none;">
                    <label>Locais vinculados <small style="color:#64748b;font-weight:normal;">(deixe vazio para ver todos os chamados da unidade)</small></label>
                    <div id="locaisList" style="border:1px solid #e2e8f0;border-radius:8px;padding:8px;max-height:160px;overflow-y:auto;background:#f8fafc;">
                        <p style="color:#94a3b8;font-size:12px;text-align:center;padding:10px;">Selecione uma unidade acima</p>
                    </div>
                    <small style="color:#94a3b8;display:block;margin-top:4px;">Se nenhum local for marcado, o usuário verá todos os chamados da unidade.</small>
                </div>

                <div class="form-group">
                    <label for="password">Senha <span id="senhaOpcional" style="color: #64748b;">(deixe em branco para manter a atual)</span></label>
                    <input type="password" id="password" name="password" minlength="6">
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" id="ativo" name="ativo" checked>
                        Usuário Ativo
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" onclick="fecharModal()" class="btn btn-secondary">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Busca em tempo real
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#usuariosTable tr');
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });

        // Máscaras
        document.getElementById('cpf').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length <= 11) {
                value = value.replace(/(\d{3})(\d)/, '$1.$2');
                value = value.replace(/(\d{3})(\d)/, '$1.$2');
                value = value.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
                e.target.value = value;
            }
        });

        document.getElementById('telefone').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length <= 11) {
                value = value.replace(/^(\d{2})(\d)/g, '($1) $2');
                value = value.replace(/(\d)(\d{4})$/, '$1-$2');
                e.target.value = value;
            }
        });

        function abrirModalNovo() {
            document.getElementById('modalTitle').textContent = 'Novo Usuário';
            document.getElementById('formUsuario').reset();
            document.getElementById('usuarioId').value = '';
            document.getElementById('password').required = true;
            document.getElementById('senhaOpcional').style.display = 'none';
            document.querySelectorAll('.check-unidade').forEach(cb => cb.checked = false);
            locaisVinculadosUsuario = [];
            document.getElementById('locaisFormGroup').style.display = 'none';
            document.getElementById('locaisList').innerHTML = '<p style="color:#94a3b8;font-size:12px;text-align:center;padding:10px;">Selecione uma unidade acima</p>';
            usernameEditadoManual = false;
            document.getElementById('modalUsuario').style.display = 'flex';
        }

        function fecharModal() {
            document.getElementById('modalUsuario').style.display = 'none';
        }

        async function editarUsuario(id) {
            try {
                const response = await fetch(`/api/usuarios/${id}`);
                const data = await response.json();
                
                if (data.success) {
                    document.getElementById('modalTitle').textContent = 'Editar Usuário';
                    document.getElementById('usuarioId').value = data.usuario.id;
                    document.getElementById('nome_completo').value = data.usuario.nome_completo || '';
                    document.getElementById('username').value = data.usuario.username;
                    document.getElementById('cpf').value = data.usuario.cpf || '';
                    document.getElementById('telefone').value = data.usuario.telefone || '';
                    document.getElementById('nivel_acesso').value = data.usuario.nivel_acesso;
                    document.getElementById('ativo').checked = data.usuario.ativo;
                    document.getElementById('password').required = false;
                    document.getElementById('password').value = '';
                    document.getElementById('senhaOpcional').style.display = 'inline';

                    // Marcar unidades vinculadas
                    const vincSet = new Set((data.usuario.unidade_ids || []).map(Number));
                    document.querySelectorAll('.check-unidade').forEach(cb => {
                        cb.checked = vincSet.has(Number(cb.value));
                    });

                    // Carregar locais vinculados
                    try {
                        const locRes = await fetch(`/api/usuarios/${id}/locais`);
                        const locData = await locRes.json();
                        locaisVinculadosUsuario = locData.success ? locData.locais.map(l => l.local_id) : [];
                    } catch (e) {
                        locaisVinculadosUsuario = [];
                    }
                    await carregarLocaisForm();

                    document.getElementById('modalUsuario').style.display = 'flex';
                } else {
                    alert('Erro ao carregar usuário');
                }
            } catch (error) {
                alert('Erro ao carregar usuário');
                console.error(error);
            }
        }

        async function salvarUsuario(event) {
            event.preventDefault();
            
            const formData = new FormData(event.target);
            const unidadeIds = Array.from(document.querySelectorAll('.check-unidade:checked')).map(cb => Number(cb.value));
            const localIds = Array.from(document.querySelectorAll('.check-local:checked')).map(cb => Number(cb.value));
            const data = {
                id: formData.get('id'),
                nome_completo: formData.get('nome_completo'),
                username: formData.get('username'),
                cpf: formData.get('cpf'),
                telefone: formData.get('telefone'),
                nivel_acesso: formData.get('nivel_acesso'),
                ativo: formData.get('ativo') === 'on',
                password: formData.get('password'),
                unidade_ids: unidadeIds
            };

            console.log('Dados do formulário:', data);

            // Validar campos obrigatórios
            if (!data.nome_completo || !data.username || !data.cpf || !data.telefone || !data.nivel_acesso) {
                alert('Por favor, preencha todos os campos obrigatórios');
                return;
            }

            // Validar senha para novo usuário
            if (!data.id && (!data.password || data.password.length < 6)) {
                alert('A senha deve ter no mínimo 6 caracteres');
                return;
            }

            try {
                const url = data.id ? `/api/usuarios/${data.id}` : '/api/usuarios';
                const method = data.id ? 'PUT' : 'POST';
                
                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Salvar locais vinculados
                    const userId = data.id || result.userId;
                    if (userId && localIds.length > 0) {
                        await fetch(`/api/usuarios/${userId}/locais`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ local_ids: localIds })
                        });
                    } else if (userId) {
                        // Limpar locais se nenhum foi marcado
                        await fetch(`/api/usuarios/${userId}/locais`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ local_ids: [] })
                        });
                    }
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error('Erro completo:', error);
                alert('Erro ao salvar usuário: ' + error.message);
            }
        }

        async function toggleStatus(id, ativoAtual) {
            const acao = ativoAtual ? 'desativar' : 'ativar';
            if (!confirm(`Deseja realmente ${acao} este usuário?`)) return;

            try {
                const response = await fetch(`/api/usuarios/${id}/toggle`, {
                    method: 'PATCH'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Erro ao alterar status do usuário');
                console.error(error);
            }
        }

        async function resetarSenha(id, username) {
            if (!confirm(`Deseja resetar a senha do usuário ${username}?`)) return;

            try {
                const response = await fetch(`/api/usuarios/${id}/reset-password`, {
                    method: 'POST'
                });
                const result = await response.json();

                if (result.success) {
                    alert(`✓ ${result.message}\n\nSenha temporária: ${result.temporaryPassword}`);
                } else {
                    alert('✗ ' + result.message);
                }
            } catch (error) {
                alert('✗ Erro ao resetar senha');
                console.error(error);
            }
        }

        async function excluirUsuario(id) {
            if (!confirm('Deseja realmente excluir este usuário? Esta ação não pode ser desfeita.')) return;

            try {
                const response = await fetch(`/api/usuarios/${id}`, {
                    method: 'DELETE'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Erro ao excluir usuário');
                console.error(error);
            }
        }

        // Modal NÃO fecha ao clicar fora (evita perda de dados acidentalmente)

        // Sugerir username com primeiro+último nome (só em modo NOVO usuário e quando username está vazio ou ainda não foi editado manualmente)
        let usernameEditadoManual = false;
        document.getElementById('username').addEventListener('input', function() {
            usernameEditadoManual = true;
        });

        function sugerirUsername() {
            // Só sugere quando estamos criando NOVO (sem id) e o usuário ainda não editou manualmente
            const id = document.getElementById('usuarioId').value;
            if (id) return; // editar — não mexe
            if (usernameEditadoManual && document.getElementById('username').value.trim() !== '') return;

            const nome = document.getElementById('nome_completo').value.trim();
            if (!nome) return;
            const partes = nome.split(/\s+/).filter(p => p.length > 0);
            if (partes.length === 0) return;
            const primeiro = partes[0].toLowerCase();
            const ultimo = partes.length > 1 ? partes[partes.length - 1].toLowerCase() : '';
            // Remover acentos
            const removerAcento = (s) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
            const sugestao = ultimo ? `${removerAcento(primeiro)}${removerAcento(ultimo)}` : removerAcento(primeiro);
            document.getElementById('username').value = sugestao;
        }

        // ── Locais (sub-unidades) ──
        let locaisVinculadosUsuario = []; // IDs dos locais vinculados ao usuário sendo editado

        async function carregarLocaisForm() {
            const unidadeIds = Array.from(document.querySelectorAll('.check-unidade:checked')).map(cb => Number(cb.value));
            const container = document.getElementById('locaisList');
            const group = document.getElementById('locaisFormGroup');

            if (unidadeIds.length === 0) {
                group.style.display = 'none';
                container.innerHTML = '<p style="color:#94a3b8;font-size:12px;text-align:center;padding:10px;">Selecione uma unidade acima</p>';
                return;
            }

            container.innerHTML = '<p style="color:#94a3b8;font-size:12px;text-align:center;padding:10px;">Carregando locais...</p>';
            group.style.display = 'block';

            try {
                let todosLocais = [];
                for (const uid of unidadeIds) {
                    const r = await fetch(`/api/unidades/${uid}/locais`);
                    const d = await r.json();
                    if (d.success && d.locais.length > 0) {
                        todosLocais.push(...d.locais.map(l => ({ ...l, unidade_id: uid })));
                    }
                }

                if (todosLocais.length === 0) {
                    group.style.display = 'none';
                    return;
                }

                const vincSet = new Set(locaisVinculadosUsuario.map(Number));
                container.innerHTML = todosLocais.map(l => `
                    <label style="display:flex;align-items:center;gap:8px;padding:5px 8px;cursor:pointer;font-size:13px;border-radius:5px;" onmouseover="this.style.background='#fff'" onmouseout="this.style.background='transparent'">
                        <input type="checkbox" class="check-local" value="${l.id}" style="width:auto" ${vincSet.has(l.id) ? 'checked' : ''}>
                        <span>📍 ${l.nome}</span>
                    </label>
                `).join('');
            } catch (e) {
                container.innerHTML = '<p style="color:#ef4444;font-size:12px;text-align:center;padding:10px;">Erro ao carregar locais</p>';
            }
        }
    </script>
</body>
</html>
