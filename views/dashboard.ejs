<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - WhatsApp SESAU</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .dash-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 16px;
        }
        @media (max-width: 1100px) { .dash-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 600px) { .dash-grid { grid-template-columns: 1fr; } }

        .mini-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .mini-card-icon {
            width: 36px; height: 36px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px; flex-shrink: 0;
        }
        .mini-card-icon.green { background: #dcfce7; }
        .mini-card-icon.blue { background: #dbeafe; }
        .mini-card-icon.purple { background: #ede9fe; }
        .mini-card-icon.orange { background: #ffedd5; }
        .mini-card-icon.red { background: #fee2e2; }
        .mini-card-icon.teal { background: #ccfbf1; }
        .mini-card-info h4 {
            font-size: 20px; font-weight: 700; color: #1e293b; margin: 0; line-height: 1.2;
        }
        .mini-card-info p {
            font-size: 11px; color: #64748b; margin: 2px 0 0; font-weight: 500;
        }

        .dash-panels {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }
        @media (max-width: 900px) { .dash-panels { grid-template-columns: 1fr; } }

        .dash-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 16px;
        }
        .dash-card h3 {
            font-size: 13px; font-weight: 600; color: #475569;
            margin: 0 0 12px; text-transform: uppercase; letter-spacing: 0.3px;
        }

        .chart-container {
            position: relative;
            height: 140px;
            width: 100%;
        }
        .chart-bar-group {
            display: flex;
            align-items: flex-end;
            gap: 4px;
            height: 110px;
            padding-top: 10px;
        }
        .chart-bar-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            height: 100%;
            justify-content: flex-end;
        }
        .chart-bar {
            width: 100%;
            max-width: 28px;
            border-radius: 4px 4px 0 0;
            background: linear-gradient(180deg, #25D366, #128C7E);
            min-height: 3px;
            transition: height 0.4s ease;
        }
        .chart-bar-label {
            font-size: 9px;
            color: #94a3b8;
            font-weight: 500;
        }

        .cat-list { list-style: none; padding: 0; margin: 0; }
        .cat-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
            border-bottom: 1px solid #f1f5f9;
        }
        .cat-item:last-child { border-bottom: none; }
        .cat-dot {
            width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
        }
        .cat-name { font-size: 12px; color: #334155; flex: 1; }
        .cat-count {
            font-size: 12px; font-weight: 700; color: #1e293b;
            background: #f1f5f9; padding: 2px 8px; border-radius: 10px;
        }

        .atendente-list { list-style: none; padding: 0; margin: 0; }
        .atendente-item {
            display: flex; align-items: center; gap: 10px;
            padding: 7px 0; border-bottom: 1px solid #f1f5f9;
        }
        .atendente-item:last-child { border-bottom: none; }
        .atendente-avatar-sm {
            width: 26px; height: 26px; border-radius: 6px;
            background: linear-gradient(135deg, #25D366, #128C7E);
            color: white; display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 700; flex-shrink: 0;
        }
        .atendente-name { font-size: 12px; color: #334155; flex: 1; }
        .atendente-count {
            font-size: 11px; font-weight: 700; color: #1e293b;
            background: #f1f5f9; padding: 2px 8px; border-radius: 10px;
        }

        .conn-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }
        @media (max-width: 900px) { .conn-section { grid-template-columns: 1fr; } }

        .conn-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 16px;
        }
        .conn-card h3 {
            font-size: 13px; font-weight: 600; color: #475569;
            margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.3px;
        }
        .conn-status {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600;
        }
        .conn-status.online { background: #dcfce7; color: #16a34a; }
        .conn-status.offline { background: #fee2e2; color: #dc2626; }
        .conn-status-dot {
            width: 7px; height: 7px; border-radius: 50%;
        }
        .conn-status.online .conn-status-dot { background: #16a34a; }
        .conn-status.offline .conn-status-dot { background: #dc2626; }
        .conn-actions { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; }
        .conn-actions button {
            padding: 8px 16px; border-radius: 6px; font-size: 12px;
            font-weight: 600; cursor: pointer; border: none; transition: all 0.2s;
        }
        .btn-connect { background: #25D366; color: white; }
        .btn-connect:hover { background: #128C7E; }
        .btn-connect:disabled { background: #cbd5e1; cursor: not-allowed; }
        .btn-disconnect { background: #fee2e2; color: #dc2626; }
        .btn-disconnect:hover { background: #fecaca; }
        #qrcode-container { margin-top: 12px; text-align: center; }
        #qrcode-container img { max-width: 200px; border-radius: 8px; }
        #qrcode-container h4 { font-size: 12px; color: #475569; margin: 0 0 8px; }
        #qrcode-container p { font-size: 11px; color: #94a3b8; margin: 8px 0 0; }

        .donut-container {
            display: flex; align-items: center; gap: 16px;
        }
        .donut-svg { width: 90px; height: 90px; flex-shrink: 0; }
        .donut-legend { list-style: none; padding: 0; margin: 0; }
        .donut-legend li {
            display: flex; align-items: center; gap: 6px;
            font-size: 11px; color: #475569; padding: 3px 0;
        }
        .donut-legend-dot {
            width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0;
        }
    </style>
</head>
<body data-bot-connected="<%= session && session.is_connected ? 'true' : 'false' %>">
    <div class="dashboard">
        <%- include('partials/sidebar', { activePage: 'dashboard', username, role: nivelAcesso === 'gerenciador' ? 'Gerenciador' : 'Administrador', isAdmin: true, nivelAcesso: nivelAcesso || 'administrador' }) %>

        <main class="main-content">
            <div class="topbar">
                <div class="topbar-title-group">
                    <button type="button" class="menu-toggle" aria-label="Abrir menu">
                        <span></span><span></span><span></span>
                    </button>
                    <h2>Dashboard</h2>
                </div>
                <div class="topbar-actions">
                    <% if (session && session.is_connected) { %>
                        <span class="badge success">✓ Conectado</span>
                    <% } else { %>
                        <span class="badge info">○ Desconectado</span>
                    <% } %>
                </div>
            </div>

            <div class="content" style="padding: 16px;">
                <!-- Banner Meus Chamados -->
                <div id="bannerMeusChamados" style="display:none; background:linear-gradient(135deg,#0ea5e9,#0284c7); border-radius:10px; padding:14px 20px; margin-bottom:14px; color:white; align-items:center; justify-content:space-between; gap:12px;">
                    <div>
                        <strong style="font-size:14px;">📋 Você tem <span id="bannerQtd">0</span> chamado(s) em andamento</strong>
                        <p style="font-size:12px;opacity:0.85;margin:4px 0 0;">Clique para ver seus chamados e encerrar os que já foram atendidos.</p>
                    </div>
                    <a href="/meus-chamados" style="background:white;color:#0284c7;padding:8px 16px;border-radius:6px;font-size:12px;font-weight:600;text-decoration:none;white-space:nowrap;">Ver Meus Chamados →</a>
                </div>

                <!-- Mini Stats Cards -->
                <div class="dash-grid">
                    <div class="mini-card">
                        <div class="mini-card-icon blue">💬</div>
                        <div class="mini-card-info">
                            <h4 id="statMsgsHoje">0</h4>
                            <p>Mensagens hoje</p>
                        </div>
                    </div>
                    <div class="mini-card">
                        <div class="mini-card-icon orange">📋</div>
                        <div class="mini-card-info">
                            <h4 id="statChamados24h">0</h4>
                            <p>Chamados 24h</p>
                        </div>
                    </div>
                    <div class="mini-card">
                        <div class="mini-card-icon green">✅</div>
                        <div class="mini-card-info">
                            <h4 id="statFinalizados">0</h4>
                            <p>Finalizados hoje</p>
                        </div>
                    </div>
                    <div class="mini-card">
                        <div class="mini-card-icon purple">👥</div>
                        <div class="mini-card-info">
                            <h4 id="statContatos">0</h4>
                            <p>Contatos ativos</p>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="dash-panels">
                    <!-- Mensagens por hora -->
                    <div class="dash-card">
                        <h3>📊 Mensagens por hora (12h)</h3>
                        <div class="chart-container">
                            <div class="chart-bar-group" id="chartMsgsHora"></div>
                        </div>
                    </div>

                    <!-- Chamados 24h - Donut -->
                    <div class="dash-card">
                        <h3>🎯 Chamados últimas 24h</h3>
                        <div class="donut-container">
                            <svg class="donut-svg" viewBox="0 0 36 36" id="donutChart">
                                <circle cx="18" cy="18" r="14" fill="none" stroke="#f1f5f9" stroke-width="4"/>
                            </svg>
                            <ul class="donut-legend" id="donutLegend">
                                <li><span class="donut-legend-dot" style="background:#f59e0b"></span> Pendentes: <strong id="lgPendentes">0</strong></li>
                                <li><span class="donut-legend-dot" style="background:#3b82f6"></span> Em atendimento: <strong id="lgAtendimento">0</strong></li>
                                <li><span class="donut-legend-dot" style="background:#10b981"></span> Finalizados: <strong id="lgFinalizados">0</strong></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Second Row -->
                <div class="dash-panels">
                    <!-- Categorias -->
                    <div class="dash-card">
                        <h3>📂 Top categorias (24h)</h3>
                        <ul class="cat-list" id="listCategorias">
                            <li class="cat-item"><span class="cat-name" style="color:#94a3b8">Carregando...</span></li>
                        </ul>
                    </div>

                    <!-- Atendentes -->
                    <div class="dash-card">
                        <h3>🏆 Atendentes mais ativos (24h)</h3>
                        <ul class="atendente-list" id="listAtendentes">
                            <li class="atendente-item"><span class="atendente-name" style="color:#94a3b8">Carregando...</span></li>
                        </ul>
                    </div>
                </div>

                <!-- Connection Section -->
                <div class="conn-section">
                    <div class="conn-card">
                        <h3>📱 WhatsApp <% if (session && session.unidade_nome) { %><small style="font-size:11px;color:#64748b;font-weight:normal;">— <%= session.unidade_nome %></small><% } %></h3>
                        <div id="status-container">
                            <% if (session && session.is_connected) { %>
                                <span class="conn-status online"><span class="conn-status-dot"></span> Conectado</span>
                                <p style="font-size:11px;color:#64748b;margin:6px 0 0;">Última conexão: <%= session.last_connected ? new Date(session.last_connected).toLocaleString('pt-BR') : '—' %></p>
                            <% } else { %>
                                <span class="conn-status offline"><span class="conn-status-dot"></span> Desconectado</span>
                                <% if (typeof isLegacyInstance !== 'undefined' && isLegacyInstance) { %>
                                    <p style="font-size:11px;color:#64748b;margin:6px 0 0;">Clique para conectar</p>
                                <% } else { %>
                                    <p style="font-size:11px;color:#f59e0b;margin:6px 0 0;">⚠️ Conecte pela tela <a href="/instancias" style="color:#f59e0b;font-weight:600;">Instâncias</a></p>
                                <% } %>
                            <% } %>
                        </div>
                    </div>

                    <div class="conn-card">
                        <h3>🤖 Bot de Atendimento</h3>
                        <div id="bot-status-container">
                            <% if (session && session.is_connected) { %>
                                <span class="conn-status online"><span class="conn-status-dot"></span> Bot ativo</span>
                                <p style="font-size:11px;color:#64748b;margin:6px 0 0;">Chatbot ativo na mesma sessão do WhatsApp.</p>
                            <% } else { %>
                                <span class="conn-status offline"><span class="conn-status-dot"></span> Aguardando</span>
                                <p style="font-size:11px;color:#64748b;margin:6px 0 0;">Conecte o WhatsApp para ativar o bot.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        const initialBotConnected = document.body.dataset.botConnected === 'true';
        const connectBtn = document.getElementById('connectBtn');
        const disconnectBtn = document.getElementById('disconnectBtn');
        const qrcodeContainer = document.getElementById('qrcode-container');
        const qrcodeImg = document.getElementById('qrcode');
        const statusContainer = document.getElementById('status-container');
        const botStatusContainer = document.getElementById('bot-status-container');
        const menuToggle = document.querySelector('.menu-toggle');
        const sidebarOverlay = document.querySelector('.sidebar-overlay');

        function toggleSidebar(forceOpen) {
            if (typeof forceOpen === 'boolean') {
                document.body.classList.toggle('sidebar-open', forceOpen);
                return;
            }
            document.body.classList.toggle('sidebar-open');
        }

        if (menuToggle) menuToggle.addEventListener('click', () => toggleSidebar());
        if (sidebarOverlay) sidebarOverlay.addEventListener('click', () => toggleSidebar(false));

        document.querySelectorAll('.menu-item, .btn-logout').forEach(item => {
            item.addEventListener('click', () => { if (window.innerWidth <= 900) toggleSidebar(false); });
        });

        async function getJsonOrThrow(response) {
            if (response.status === 401) { window.location.href = '/'; throw new Error('Sessão expirada'); }
            const ct = response.headers.get('content-type') || '';
            if (!ct.includes('application/json')) throw new Error('Resposta inválida');
            return response.json();
        }

        // --- Charts ---
        function renderBarChart(data) {
            const el = document.getElementById('chartMsgsHora');
            if (!data || data.length === 0) {
                el.innerHTML = '<p style="font-size:11px;color:#94a3b8;text-align:center;width:100%;padding:40px 0;">Sem dados</p>';
                return;
            }
            const max = Math.max(...data.map(d => d.total), 1);
            el.innerHTML = data.map(d => {
                const h = Math.max((d.total / max) * 90, 3);
                return `<div class="chart-bar-item">
                    <div class="chart-bar" style="height:${h}px;" title="${d.total} msgs"></div>
                    <span class="chart-bar-label">${String(d.hora).padStart(2,'0')}h</span>
                </div>`;
            }).join('');
        }

        function renderDonut(pendentes, emAtendimento, finalizados) {
            const total = pendentes + emAtendimento + finalizados;
            const svg = document.getElementById('donutChart');
            document.getElementById('lgPendentes').textContent = pendentes;
            document.getElementById('lgAtendimento').textContent = emAtendimento;
            document.getElementById('lgFinalizados').textContent = finalizados;

            if (total === 0) {
                svg.innerHTML = '<circle cx="18" cy="18" r="14" fill="none" stroke="#f1f5f9" stroke-width="4"/><text x="18" y="19" text-anchor="middle" font-size="4" fill="#94a3b8">0</text>';
                return;
            }

            const circumference = 2 * Math.PI * 14;
            const segments = [
                { value: pendentes, color: '#f59e0b' },
                { value: emAtendimento, color: '#3b82f6' },
                { value: finalizados, color: '#10b981' }
            ];

            let offset = 0;
            let paths = '<circle cx="18" cy="18" r="14" fill="none" stroke="#f1f5f9" stroke-width="4"/>';
            segments.forEach(seg => {
                if (seg.value > 0) {
                    const len = (seg.value / total) * circumference;
                    paths += `<circle cx="18" cy="18" r="14" fill="none" stroke="${seg.color}" stroke-width="4" stroke-dasharray="${len} ${circumference - len}" stroke-dashoffset="${-offset}" transform="rotate(-90 18 18)"/>`;
                    offset += len;
                }
            });
            paths += `<text x="18" y="19.5" text-anchor="middle" font-size="5" font-weight="700" fill="#1e293b">${total}</text>`;
            svg.innerHTML = paths;
        }

        function renderCategorias(data) {
            const el = document.getElementById('listCategorias');
            const colors = ['#3b82f6','#10b981','#f59e0b','#8b5cf6','#ef4444'];
            if (!data || data.length === 0) {
                el.innerHTML = '<li class="cat-item"><span class="cat-name" style="color:#94a3b8">Nenhum chamado nas últimas 24h</span></li>';
                return;
            }
            el.innerHTML = data.map((c, i) => `
                <li class="cat-item">
                    <span class="cat-dot" style="background:${colors[i % colors.length]}"></span>
                    <span class="cat-name">${c.categoria || 'Sem categoria'}</span>
                    <span class="cat-count">${c.total}</span>
                </li>
            `).join('');
        }

        function renderAtendentes(data) {
            const el = document.getElementById('listAtendentes');
            if (!data || data.length === 0) {
                el.innerHTML = '<li class="atendente-item"><span class="atendente-name" style="color:#94a3b8">Nenhum atendimento nas últimas 24h</span></li>';
                return;
            }
            el.innerHTML = data.map(a => `
                <li class="atendente-item">
                    <span class="atendente-avatar-sm">${(a.atendente_nome || '?').charAt(0).toUpperCase()}</span>
                    <span class="atendente-name">${a.atendente_nome}</span>
                    <span class="atendente-count">${a.total}</span>
                </li>
            `).join('');
        }

        // --- Load Stats ---
        async function loadStats() {
            try {
                const response = await fetch('/api/stats');
                const data = await getJsonOrThrow(response);

                document.getElementById('statMsgsHoje').textContent = data.messagesToday || 0;
                document.getElementById('statContatos').textContent = data.activeContacts || 0;
                document.getElementById('statChamados24h').textContent = data.chamados24h?.total || 0;
                document.getElementById('statFinalizados').textContent = data.chamadosHoje?.finalizados || 0;

                renderBarChart(data.msgsPorHora || []);
                renderDonut(
                    Number(data.chamados24h?.pendentes || 0),
                    Number(data.chamados24h?.em_atendimento || 0),
                    Number(data.chamados24h?.finalizados || 0)
                );
                renderCategorias(data.chamadosPorCategoria || []);
                renderAtendentes(data.atendentesAtivos || []);
            } catch (error) {
                console.error('Erro ao carregar estatísticas:', error);
            }
        }

        loadStats();
        setInterval(loadStats, 30000);

        // --- Meus Chamados Banner ---
        async function carregarBannerMeusChamados() {
            try {
                const response = await fetch('/api/chamados/meus-em-andamento');
                const result = await response.json();
                const banner = document.getElementById('bannerMeusChamados');
                if (result.success && result.total > 0) {
                    document.getElementById('bannerQtd').textContent = result.total;
                    banner.style.display = 'flex';
                } else {
                    banner.style.display = 'none';
                }
            } catch (e) {
                console.error('Erro ao verificar meus chamados:', e);
            }
        }
        carregarBannerMeusChamados();
        setInterval(carregarBannerMeusChamados, 15000);

        // --- Connection Logic ---
        function renderConnectingState() {
            statusContainer.innerHTML = `
                <span class="conn-status offline"><span class="conn-status-dot"></span> Aguardando QR Code</span>
                <p style="font-size:11px;color:#64748b;margin:6px 0 0;">Escaneie o QR Code abaixo</p>
            `;
        }

        function renderConnectionError(message) {
            statusContainer.innerHTML = `
                <span class="conn-status offline"><span class="conn-status-dot"></span> Falha</span>
                <p style="font-size:11px;color:#64748b;margin:6px 0 0;">${message}</p>
            `;
            qrcodeContainer.style.display = 'none';
            qrcodeImg.src = '';
            if (connectBtn) { connectBtn.disabled = false; connectBtn.textContent = '🔗 Conectar'; }
        }

        function renderBotStatus(isConnected) {
            botStatusContainer.innerHTML = isConnected
                ? `<span class="conn-status online"><span class="conn-status-dot"></span> Bot ativo</span><p style="font-size:11px;color:#64748b;margin:6px 0 0;">Chatbot ativo na mesma sessão do WhatsApp.</p>`
                : `<span class="conn-status offline"><span class="conn-status-dot"></span> Aguardando</span><p style="font-size:11px;color:#64748b;margin:6px 0 0;">Conecte o WhatsApp para ativar o bot.</p>`;
        }

        if (connectBtn) {
            connectBtn.addEventListener('click', async () => {
                connectBtn.disabled = true;
                connectBtn.textContent = '⏳ Conectando...';
                renderConnectingState();
                try {
                    const response = await fetch('/whatsapp/connect', { method: 'POST' });
                    const data = await getJsonOrThrow(response);
                    if (data.success) {
                        if (data.connected) { location.reload(); return; }
                        checkStatus();
                    } else {
                        alert(data.message);
                        connectBtn.disabled = false;
                        connectBtn.textContent = '🔗 Conectar';
                    }
                } catch (error) {
                    alert('Erro ao conectar');
                    connectBtn.disabled = false;
                    connectBtn.textContent = '🔗 Conectar';
                }
            });
        }

        if (disconnectBtn) {
            disconnectBtn.addEventListener('click', async () => {
                disconnectBtn.disabled = true;
                disconnectBtn.textContent = '⏳...';
                try {
                    const response = await fetch('/whatsapp/disconnect', { method: 'POST' });
                    const data = await getJsonOrThrow(response);
                    if (data.success) location.reload();
                    else alert(data.message || 'Erro ao desconectar');
                } catch (error) { alert('Erro ao desconectar'); }
                finally { disconnectBtn.disabled = false; disconnectBtn.textContent = '⛔ Desconectar'; }
            });
        }

        function checkStatus() {
            const interval = setInterval(async () => {
                try {
                    const response = await fetch('/whatsapp/status');
                    const data = await getJsonOrThrow(response);
                    if (data.qrCode) { qrcodeImg.src = data.qrCode; qrcodeContainer.style.display = 'block'; }
                    if (!data.connected && !data.qrCode && data.error) { clearInterval(interval); renderConnectionError(data.error); return; }
                    renderBotStatus(Boolean(data.connected));
                    if (data.connected) { clearInterval(interval); location.reload(); }
                } catch (error) { console.error('Erro ao verificar status:', error); }
            }, 2000);
        }

        renderBotStatus(initialBotConnected);
    </script>
</body>
</html>
